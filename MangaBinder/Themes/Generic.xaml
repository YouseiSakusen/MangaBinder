<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:MangaBinder.Controls"
	xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

	<!-- ─────────────────────────────────────────────────────────────────── -->
	<!-- PageLayout ControlTemplate -->
	<!-- ─────────────────────────────────────────────────────────────────── -->
	<Style TargetType="{x:Type controls:PageLayout}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:PageLayout}">
					<Grid>
						<Grid.ColumnDefinitions>
							<!-- 左カラム -->
							<ColumnDefinition Width="{TemplateBinding LeftColumnWidth}" MinWidth="{TemplateBinding LeftColumnMinWidth}" />
							<!-- 中央カラム -->
							<ColumnDefinition Width="{TemplateBinding MainColumnWidth}" />
							<!-- Splitter カラム -->
							<ColumnDefinition Width="Auto" />
							<!-- 右カラム -->
							<ColumnDefinition Width="{TemplateBinding RightColumnWidth}" MinWidth="{TemplateBinding RightColumnMinWidth}" />
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<!-- 上部エリア（Auto） -->
							<RowDefinition Height="Auto" />
							<!-- 本文エリア（*） -->
							<RowDefinition Height="*" />
							<!-- フッタエリア（Auto） -->
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<!-- ═══════════════════════════════════════════════════════════════ -->
						<!-- 左カラム - 上部 -->
						<!-- ═══════════════════════════════════════════════════════════════ -->

						<!-- ═══════════════════════════════════════════════════════════════ -->
						<!-- 中央カラム - 上部（アイキャッチカード + TopContent） -->
						<!-- ═══════════════════════════════════════════════════════════════ -->
						<Grid Grid.Column="1" Grid.Row="0" Margin="0,8,0,8">
							<Grid.ColumnDefinitions>
								<!-- アイキャッチカード -->
								<ColumnDefinition Width="Auto" />
								<!-- 16px マージン -->
								<ColumnDefinition Width="16" />
								<!-- TopContent -->
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<!-- ─────────────────────────────────────────────────────── -->
							<!-- アイキャッチカード -->
							<!-- ─────────────────────────────────────────────────────── -->
							<ui:Card Grid.Column="0" Padding="14,10">
								<Grid>
									<Grid.ColumnDefinitions>
										<!-- シンボルアイコン -->
										<ColumnDefinition Width="Auto" />
										<!-- テキスト領域 -->
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<!-- シンボルアイコン -->
									<ui:SymbolIcon
										Grid.Column="0"
										Symbol="{TemplateBinding EyecatchSymbol}"
										FontSize="48"
										Foreground="{DynamicResource BindingAccentBrush}"
										Margin="0,0,12,0"
										VerticalAlignment="Center" />

									<!-- テキスト領域 -->
									<StackPanel Grid.Column="1" VerticalAlignment="Center">
										<!-- 見出し -->
										<TextBlock
											Text="{TemplateBinding EyecatchTitle}"
											FontSize="11"
											Margin="0,0,0,2"
											Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

										<!-- 表示値 -->
										<TextBlock
											Text="{TemplateBinding EyecatchValueText}"
											FontSize="16"
											FontWeight="SemiBold"
											Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
									</StackPanel>
								</Grid>
							</ui:Card>

							<!-- TopContent -->
							<ContentPresenter Grid.Column="2" Content="{TemplateBinding TopContent}" />
						</Grid>

						<!-- ═══════════════════════════════════════════════════════════════ -->
						<!-- 右カラム - 上部 -->
						<!-- ═══════════════════════════════════════════════════════════════ -->

						<!-- ═══════════════════════════════════════════════════════════════ -->
						<!-- 左カラム - 本文 -->
						<!-- ═══════════════════════════════════════════════════════════════ -->
						<ContentPresenter Grid.Column="0" Grid.Row="1" Content="{TemplateBinding LeftContent}" />

						<!-- ═══════════════════════════════════════════════════════════════ -->
						<!-- 中央カラム - 本文 -->
						<!-- ═══════════════════════════════════════════════════════════════ -->
						<ContentPresenter Grid.Column="1" Grid.Row="1" Content="{TemplateBinding MainContent}" />

						<!-- ═══════════════════════════════════════════════════════════════ -->
						<!-- GridSplitter - MainContent と RightContent の間 -->
						<!-- ═══════════════════════════════════════════════════════════════ -->
						<GridSplitter
							x:Name="MainRightSplitter"
							Grid.Column="2"
							Grid.Row="1"
							Width="5"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							Background="{DynamicResource DividerStrokeColorDefaultBrush}"
							ShowsPreview="True"
							ResizeDirection="Columns"
							ResizeBehavior="PreviousAndNext"
							Visibility="Collapsed" />

						<!-- ═══════════════════════════════════════════════════════════════ -->
						<!-- 右カラム - 本文 -->
						<!-- ═══════════════════════════════════════════════════════════════ -->
						<ContentPresenter Grid.Column="3" Grid.Row="1" Content="{TemplateBinding RightContent}" />

						<!-- ═══════════════════════════════════════════════════════════════ -->
						<!-- 左カラム - フッタ -->
						<!-- ═══════════════════════════════════════════════════════════════ -->
						<ContentPresenter Grid.Column="0" Grid.Row="2" Content="{TemplateBinding FooterLeftContent}" />

						<!-- ═══════════════════════════════════════════════════════════════ -->
						<!-- 中央カラム - フッタ -->
						<!-- ═══════════════════════════════════════════════════════════════ -->
						<ContentPresenter Grid.Column="1" Grid.Row="2" Content="{TemplateBinding FooterContent}" />

						<!-- ═══════════════════════════════════════════════════════════════ -->
						<!-- 右カラム - フッタ -->
						<!-- ═══════════════════════════════════════════════════════════════ -->
						<ContentPresenter Grid.Column="3" Grid.Row="2" Content="{TemplateBinding FooterRightContent}" />
					</Grid>

					<ControlTemplate.Triggers>
						<Trigger Property="IsMainRightSplitterEnabled" Value="True">
							<Setter
								TargetName="MainRightSplitter"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ─────────────────────────────────────────────────────────────────── -->
	<!-- BindingPageLayout ControlTemplate -->
	<!-- ─────────────────────────────────────────────────────────────────── -->
	<Style TargetType="{x:Type local:BindingPageLayout}"
		   xmlns:local="clr-namespace:MangaBinder.Bindings">
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:BindingPageLayout}">
					<Grid>
						<Grid.RowDefinitions>
							<!-- Row 0: 作品タイトル -->
							<RowDefinition Height="Auto" />
							<!-- Row 1: Content -->
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<!-- Row 0: 作品タイトル -->
						<ui:TextBox
							Grid.Row="0"
							Background="Transparent"
							BorderThickness="0"
							BorderBrush="Transparent"
							Padding="0"
							FocusVisualStyle="{x:Null}"
							CaretBrush="Transparent"
							IsReadOnly="True"
							IsTabStop="False"
							Focusable="True"
							Cursor="IBeam"
							Text="{TemplateBinding SeriesTitle}"
							FontSize="17"
							Foreground="{DynamicResource TextFillColorPrimaryBrush}"
							Margin="0,0,0,12" />

						<!-- Row 1: Content -->
						<ContentPresenter
							Grid.Row="1"
							Content="{TemplateBinding Content}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
