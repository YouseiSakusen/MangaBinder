<UserControl x:Class="MangaBinder.Controls.MangaSeriesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:MangaBinder.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             VerticalAlignment="Top"
             HorizontalAlignment="Center"
             MinWidth="240">

    <!-- 作品サムネイルカード。DataContext は MangaSeriesCardViewModel を想定します。 -->
    <ui:Card Padding="10" VerticalAlignment="Top">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto" />
                <!-- Thumbnail -->
                <RowDefinition Height="Auto" />
                <!-- SeriesVolumeStatus -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── Header（見出し） ── -->
            <TextBlock
                Grid.Row="0"
                Text="{Binding Header.Value}"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Margin="0,0,0,8"
                Visibility="{Binding HasHeader.Value, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- ── Thumbnail（サムネイル画像） ── -->
            <Border
                Grid.Row="1"
                Width="160"
                Height="224"
                HorizontalAlignment="Center"
                Margin="0,0,0,8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="4"
                ClipToBounds="True">
                <Image
                    Width="160"
                    Height="224"
                    Stretch="UniformToFill"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="{Binding ThumbnailSource.Value}" />
            </Border>

            <!-- ── SeriesVolumeStatus（巻数情報） ── -->
            <local:SeriesVolumeStatus
                Grid.Row="2"
                HorizontalAlignment="Center"
                DataContext="{Binding VolumeStatus.Value}" />
        </Grid>
    </ui:Card>
</UserControl>
