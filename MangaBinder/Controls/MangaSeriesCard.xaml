<UserControl x:Class="MangaBinder.Controls.MangaSeriesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:MangaBinder.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="MangaSeriesCardControl"
             VerticalAlignment="Top"
             HorizontalAlignment="Center"
             MinWidth="240">

    <!-- 作品サムネイルカード。DataContext は MangaSeriesCardViewModel を想定します。 -->
    <ui:Card Padding="10" VerticalAlignment="Top">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto" />
                <!-- Thumbnail -->
                <RowDefinition Height="Auto" />
                <!-- SeriesVolumeStatus -->
                <RowDefinition Height="Auto" />
                <!-- Auxiliary info: LastUpdate / Memo -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── Header（見出し） ── -->
            <TextBlock
                Grid.Row="0"
                Text="{Binding Header.Value}"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Margin="0,0,0,8"
                Visibility="{Binding HasHeader.Value, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- ── Thumbnail（サムネイル画像） ── -->
            <Border
                Grid.Row="1"
                Width="160"
                Height="224"
                HorizontalAlignment="Center"
                Margin="0,0,0,8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="4"
                ClipToBounds="True">
                <Image
                    Width="160"
                    Height="224"
                    Stretch="UniformToFill"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="{Binding ThumbnailSource.Value}" />
            </Border>

            <!-- ── SeriesVolumeStatus（巻数情報） ── -->
            <local:SeriesVolumeStatus
                Grid.Row="2"
                HorizontalAlignment="Center"
                DataContext="{Binding VolumeStatus.Value}" />

            <!-- ── Auxiliary Info Row：メモの有無で異なるレイアウト── -->
            <Grid
                Grid.Row="3"
                Margin="0,8,0,0"
                VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- 可変幅（中央配置用） -->
                    <ColumnDefinition Width="*" />
                    <!-- SeriesLastUpdate -->
                    <ColumnDefinition Width="Auto" />
                    <!-- SeriesMemo -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 可変幅（中央配置用） -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ── SeriesLastUpdate ── -->
                <local:SeriesLastUpdate
                    x:Name="SeriesLastUpdateControl"
                    DataContext="{Binding LastUpdateStatus}">
                    <local:SeriesLastUpdate.Style>
                        <Style TargetType="local:SeriesLastUpdate">
                            <Setter Property="Grid.Column" Value="1" />
                            <Setter Property="Grid.ColumnSpan" Value="1" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Style.Triggers>
                                <!-- メモなし時：SeriesLastUpdateが横幅いっぱいにStretch -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding DataContext.ShowMemo.Value, ElementName=MangaSeriesCardControl}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="4" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </MultiDataTrigger>
                                <!-- メモなし時（MemoStatus.HasMemo=false） -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding DataContext.ShowMemo.Value, ElementName=MangaSeriesCardControl}" Value="True" />
                                        <Condition Binding="{Binding DataContext.MemoStatus.HasMemo.Value, ElementName=MangaSeriesCardControl}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="4" />
									<Setter Property="HorizontalAlignment" Value="Stretch" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:SeriesLastUpdate.Style>
                </local:SeriesLastUpdate>

                <!-- ── SeriesMemo（ShowMemo=true かつ HasMemo=true の場合だけ表示） ── -->
                <Border
                    Grid.Column="2"
                    Margin="8,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <!-- ShowMemo=true かつ MemoStatus.HasMemo=true の時だけ表示 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding DataContext.ShowMemo.Value, ElementName=MangaSeriesCardControl}" Value="True" />
                                        <Condition Binding="{Binding DataContext.MemoStatus.HasMemo.Value, ElementName=MangaSeriesCardControl}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <local:SeriesMemo
                        DataContext="{Binding DataContext.MemoStatus, ElementName=MangaSeriesCardControl}" />
                </Border>
            </Grid>
        </Grid>
    </ui:Card>
</UserControl>
