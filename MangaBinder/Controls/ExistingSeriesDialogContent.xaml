<UserControl x:Class="MangaBinder.Controls.ExistingSeriesDialogContent"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="clr-namespace:MangaBinder.Controls"
			 xmlns:extensions="clr-namespace:MangaBinder.Extensions"
			 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
			 mc:Ignorable="d" 
			 d:DesignHeight="500" d:DesignWidth="600">
	<!-- 既存作品情報を表示するダイアログコンテンツ。DataContext は MaintenanceSeriesCardViewModel を想定。 -->
	<UserControl.Resources>
		<!-- 作品カード用の DataTemplate -->
		<DataTemplate x:Key="SeriesCardTemplate">
			<ui:Card
				Padding="12,8"
				Margin="0,0,0,0">
				<Grid>
					<Grid.ColumnDefinitions>
						<!-- Col0: サムネイル -->
						<ColumnDefinition Width="Auto" />
						<!-- Col1: 作品情報 -->
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<!-- Col0: サムネイル -->
					<Border
						Grid.Column="0"
						Margin="0,0,12,0"
						Width="100"
						Height="140"
						CornerRadius="4"
						ClipToBounds="True">
						<Image
							Source="{Binding Series.Value, Converter={extensions:ThumbnailImageConverterExtension}}"
							Stretch="UniformToFill"
							RenderOptions.BitmapScalingMode="LowQuality" />
					</Border>

					<!-- Col1: 作品情報 -->
					<StackPanel
						Grid.Column="1"
						Orientation="Vertical"
						VerticalAlignment="Top">

						<!-- タイトル -->
						<ui:TextBlock
							Text="{Binding Series.Value.Title}"
							FontSize="14"
							FontWeight="SemiBold"
							TextWrapping="Wrap"
							Margin="0,0,0,4"
							Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

						<!-- 巻情報 -->
						<local:SeriesVolumeStatus
							Margin="0,0,0,4"
							DataContext="{Binding VolumeStatus.Value}" />

						<!-- 作者 -->
						<ui:TextBlock
							Text="{Binding Series.Value.Author, StringFormat='作者：{0}'}"
							TextWrapping="Wrap"
							Margin="0,0,0,4"
							FontSize="12"
							Opacity="0.8"
							Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

						<!-- メモ -->
						<ui:TextBlock
							Text="{Binding MemoStatus.Value.Memo.Value, StringFormat='メモ：{0}'}"
							TextTrimming="CharacterEllipsis"
							TextWrapping="Wrap"
							Margin="0,0,0,0"
							Foreground="{DynamicResource TextFillColorTertiaryBrush}">
							<ui:TextBlock.Style>
								<Style TargetType="ui:TextBlock">
									<Setter Property="Visibility" Value="Visible" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding MemoStatus.Value.HasMemo.Value}" Value="False">
											<Setter Property="Visibility" Value="Collapsed" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</ui:TextBlock.Style>
						</ui:TextBlock>
					</StackPanel>
				</Grid>
			</ui:Card>
		</DataTemplate>
	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<!-- 説明文 -->
			<RowDefinition Height="Auto" />
			<!-- 既存作品を開く RadioButton -->
			<RowDefinition Height="Auto" />
			<!-- 作品 ListView -->
			<RowDefinition Height="Auto" />
			<!-- 別作者の作品として追加 RadioButton -->
			<RowDefinition Height="Auto" />
			<!-- 作者入力欄 -->
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- 説明文 -->
		<ui:TextBlock
			Grid.Row="0"
			Text="同一タイトル作品をを追加する場合は、作者を設定してください。"
			TextWrapping="Wrap"
			Margin="0,0,0,12"
			Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

		<!-- 既存作品を開く RadioButton -->
		<RadioButton
			Grid.Row="1"
			GroupName="ExistingSeriesAction"
			IsChecked="True"
			Margin="0,0,0,12"
			Foreground="{DynamicResource TextFillColorPrimaryBrush}">
			<TextBlock Text="既存作品を開く" />
		</RadioButton>

		<!-- 既存作品表示用ListView -->
		<ui:ListView
			Grid.Row="2"
			SelectionMode="Single"
			Background="Transparent"
			BorderThickness="0"
			Margin="0,0,0,12"
			MaxHeight="300">
			<ui:ListViewItem
				Content="{Binding}"
				ContentTemplate="{StaticResource SeriesCardTemplate}" />
		</ui:ListView>

		<!-- 別作者の作品として追加 RadioButton -->
		<RadioButton
			Grid.Row="3"
			GroupName="ExistingSeriesAction"
			Margin="0,0,0,12"
			Foreground="{DynamicResource TextFillColorPrimaryBrush}">
			<TextBlock Text="別作者の作品として追加" />
		</RadioButton>

		<!-- 作者入力欄 -->
		<Grid
			Grid.Row="4"
			Margin="24,0,0,0">
			<Grid.ColumnDefinitions>
				<!-- 作者ラベル -->
				<ColumnDefinition Width="Auto" />
				<!-- 作者入力欄 -->
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<ui:TextBlock
				Grid.Column="0"
				Text="作者"
				VerticalAlignment="Center"
				Margin="0,0,8,0"
				Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

			<ui:TextBox
				Grid.Column="1"
				Padding="8,6" />
		</Grid>
	</Grid>
</UserControl>
