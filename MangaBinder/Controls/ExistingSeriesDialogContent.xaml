<UserControl x:Class="MangaBinder.Controls.ExistingSeriesDialogContent"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="clr-namespace:MangaBinder.Controls"
			 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
			 xmlns:behaviors="clr-namespace:MangaBinder.Behaviors"
			 mc:Ignorable="d" 
			 d:DesignHeight="500" d:DesignWidth="600">
	<!-- 既存作品情報を表示するダイアログコンテンツ。DataContext は ExistingSeriesDialogContentViewModel を想定。 -->

	<Grid>
		<Grid.RowDefinitions>
			<!-- 説明文 -->
			<RowDefinition Height="Auto" />
			<!-- 既存作品を開く RadioButton -->
			<RowDefinition Height="Auto" />
			<!-- 作品一覧 -->
			<RowDefinition Height="Auto" />
			<!-- 別作者の作品として追加 RadioButton -->
			<RowDefinition Height="Auto" />
			<!-- 作者入力欄 -->
			<RowDefinition Height="Auto" />
			<!-- 作者重複エラー InfoBar -->
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- 説明文 -->
		<ui:TextBlock
			Grid.Row="0"
			Text="同一タイトル作品をを追加する場合は、作者を設定してください。"
			TextWrapping="Wrap"
			Margin="0,0,0,12"
			Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

		<!-- 既存作品を開く RadioButton -->
		<RadioButton
			Grid.Row="1"
			GroupName="ExistingSeriesAction"
			IsChecked="{Binding IsOpenExistingSeriesSelected.Value, Mode=TwoWay}"
			Margin="0,0,0,12"
			Foreground="{DynamicResource TextFillColorPrimaryBrush}">
			<TextBlock Text="既存作品を開く" />
		</RadioButton>

		<!-- 作品一覧 -->
		<local:SelectableSeriesList
			Grid.Row="2"
			Height="160"
			IsHitTestVisible="False"
			DataContext="{Binding SelectableSeriesListViewModel}"
			Margin="0,0,0,12" />

		<!-- 別作者の作品として追加 RadioButton -->
		<RadioButton
			Grid.Row="3"
			GroupName="ExistingSeriesAction"
			IsChecked="{Binding IsAddAsOtherAuthorSelected.Value, Mode=TwoWay}"
			Margin="0,0,0,12"
			Foreground="{DynamicResource TextFillColorPrimaryBrush}">
			<TextBlock Text="別作者の作品として追加" />
		</RadioButton>

		<!-- 作者入力欄 -->
		<Grid
			Grid.Row="4"
			IsEnabled="{Binding IsAddAsOtherAuthorSelected.Value}"
			Margin="24,0,0,0">
			<Grid.ColumnDefinitions>
				<!-- 作者ラベル -->
				<ColumnDefinition Width="Auto" />
				<!-- 作者入力欄 -->
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<ui:TextBlock
				Grid.Column="0"
				Text="作者"
				VerticalAlignment="Center"
				Margin="0,0,8,0"
				Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

			<ui:TextBox
				Grid.Column="1"
				Text="{Binding NewAuthorInput.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
				InputMethod.PreferredImeState="On"
				behaviors:FocusOnChangedBehavior.Request="{Binding AuthorFocusRequest.Value}"
				Padding="8,6" />
		</Grid>

		<!-- 作者重複エラー InfoBar -->
		<ui:InfoBar
			Grid.Row="5"
			IsOpen="{Binding IsAuthorDuplicateErrorVisible.Value, Mode=OneWay}"
			Title="作者重複エラー"
			Message="同じ作者の作品が既に登録されています。"
			Severity="Warning"
			Margin="0,12,0,0" />
	</Grid>
</UserControl>
