<UserControl x:Class="MangaBinder.Controls.NewSeriesTitleDialogContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:MangaBinder.Behaviors"
             xmlns:local="clr-namespace:MangaBinder.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- 新規作品登録時のタイトル入力ダイアログコンテンツ。DataContext は NewSeriesTitleDialogContentViewModel を想定。 -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row0: 説明エリア -->
            <RowDefinition Height="Auto" />
            <!-- Row1: 作品タイトル入力Card -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════ -->
        <!-- Row0: 説明エリア                   -->
        <!-- ══════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- アイキャッチアイコン -->
                <ColumnDefinition Width="Auto" />
                <!-- 説明文 -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- BookAdd24 アイコン -->
            <ui:SymbolIcon
                Grid.Column="0"
                Symbol="BookAdd24"
                FontSize="48"
                Foreground="{DynamicResource BindingAccentBrush}"
                Margin="0,0,12,0"
                VerticalAlignment="Top" />

            <!-- 説明文 -->
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Top"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                FontSize="14"
                LineHeight="20">
                <Run Text="{Binding ApplicationName, Mode=OneWay}" />
                <Run>では同一タイトルの作品を複数登録できません。</Run>
                <LineBreak />
                <Run>登録する作品のタイトルを最初に入力してください。</Run>
            </TextBlock>
        </Grid>

        <!-- ══════════════════════════════════ -->
        <!-- Row1: 作品タイトル入力Card         -->
        <!-- ══════════════════════════════════ -->
        <ui:Card Grid.Row="1" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row0: 見出し -->
                    <RowDefinition Height="Auto" />
                    <!-- Row1: タイトル入力TextBox -->
                    <RowDefinition Height="Auto" />
                    <!-- Row2: InfoBar -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 見出し：「作品タイトル」 -->
                <TextBlock
                    Grid.Row="0"
                    Text="作品タイトル"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,8" />

                <!-- タイトル入力TextBox -->
                <ui:TextBox
                    Grid.Row="1"
                    InputMethod.PreferredImeState="On"
                    Margin="0,0,0,8"
                    Text="{Binding Title.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    behaviors:FocusAndSelectAllBehavior.Request="{Binding TitleInputFocusRequest.Value, Mode=OneWay}"
                    behaviors:SelectAllOnFocusBehavior.IsEnabled="True"
                    behaviors:TrimOnPasteBehavior.IsEnabled="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    PlaceholderText="作品のタイトルを入力してください"
                    TextWrapping="Wrap"
                    AcceptsReturn="False"
                    MinHeight="58" />

                <!-- InfoBar：未入力エラー表示 -->
                <ui:InfoBar
                    Grid.Row="2"
                    Title="入力エラー"
                    Message="{Binding ErrorMessage.Value, Mode=OneWay}"
                    Severity="Warning"
                    IsOpen="{Binding IsErrorMessageVisible.Value, Mode=OneWay}"
                    Margin="0,8,0,0" />
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
