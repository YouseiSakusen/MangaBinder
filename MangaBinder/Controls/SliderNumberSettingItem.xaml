<UserControl
	x:Class="MangaBinder.Controls.SliderNumberSettingItem"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	xmlns:behaviors="clr-namespace:MangaBinder.Behaviors"
	x:Name="Root"
	mc:Ignorable="d"
	d:DesignHeight="450"
	d:DesignWidth="800">

	<ui:Card Style="{StaticResource SliderNumberSettingItemCardStyle}">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="{Binding LabelWidth, ElementName=Root}" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="{Binding NumberBoxWidth, ElementName=Root}" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBlock
				Grid.Column="0"
				VerticalAlignment="Center"
				Style="{StaticResource SettingsItemTitleStyle}"
				Text="{Binding Label, ElementName=Root}" />
			<Slider
				Grid.Column="1"
				Margin="12,0"
				VerticalAlignment="Center"
				Minimum="{Binding Minimum, ElementName=Root}"
				Maximum="{Binding Maximum, ElementName=Root}"
				Value="{Binding Value, ElementName=Root, Mode=TwoWay}" />
			<ui:NumberBox
				Grid.Column="2"
				VerticalAlignment="Center"
				behaviors:SelectAllOnFocusBehavior.IsEnabled="True"
				ClearButtonEnabled="False"
				SpinButtonPlacementMode="Compact"
				Minimum="{Binding Minimum, ElementName=Root}"
				Maximum="{Binding Maximum, ElementName=Root}"
				Value="{Binding Value, ElementName=Root, Mode=TwoWay}" />
			<TextBlock
				Grid.Column="3"
				Margin="4,0,0,0"
				VerticalAlignment="Center"
				Text="{Binding Unit, ElementName=Root}" />
		</Grid>
	</ui:Card>
</UserControl>
