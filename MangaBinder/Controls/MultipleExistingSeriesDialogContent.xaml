<UserControl x:Class="MangaBinder.Controls.MultipleExistingSeriesDialogContent"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:controls="clr-namespace:MangaBinder.Controls"
			 mc:Ignorable="d"
			 d:DesignHeight="600" d:DesignWidth="800">

	<!-- 複数の既存作品候補から1件を選択するダイアログコンテンツ。-->
	<Grid>
		<!-- SelectableSeriesList を配置 -->
		<controls:SelectableSeriesList
			DataContext="{Binding SelectableSeriesListViewModel}" />
	</Grid>
</UserControl>
