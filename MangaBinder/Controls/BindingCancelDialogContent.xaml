<UserControl x:Class="MangaBinder.Controls.BindingCancelDialogContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:MangaBinder.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Row0: 確認メッセージ（見出し） -->
            <RowDefinition Height="Auto" />
            <!-- Row1: スペーサー -->
            <RowDefinition Height="12" />
            <!-- Row2: 確認メッセージ（本文） -->
            <RowDefinition Height="Auto" />
            <!-- Row3: スペーサー -->
            <RowDefinition Height="16" />
            <!-- Row4: Workフォルダ削除設定Card -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row0: 確認メッセージ（見出し） -->
        <TextBlock
            Grid.Row="0"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            TextWrapping="Wrap"
            LineHeight="20">
            <Run Text="{Binding SeriesTitle.Value, Mode=OneWay}" />
            <Run Text="の製本を中止します。" />
        </TextBlock>

        <!-- Row2: 確認メッセージ（本文） -->
        <TextBlock
            Grid.Row="2"
            Text="製本中の設定はクリアされ、元には戻せません。&#10;続行しますか？"
            FontSize="13"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            LineHeight="18" />

        <!-- Row4: Workフォルダ削除設定Card -->
        <ui:Card Grid.Row="4" Padding="12,8" IsEnabled="{Binding CanDeleteWorkFolder.Value}">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row0: CheckBox -->
                    <RowDefinition Height="Auto" />
                    <!-- Row1: Workフォルダパス -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row0: CheckBox -->
                <CheckBox
                    Grid.Row="0"
                    Content="ワークフォルダを削除する"
                    FontSize="12"
                    IsChecked="{Binding DeleteWorkFolder.Value, Mode=TwoWay}"
                    VerticalAlignment="Center" />

                <!-- Row1: Workフォルダパス -->
                <TextBlock
                    Grid.Row="1"
                    Text="{Binding WorkSeriesFolderPath.Value, Mode=OneWay}"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    LineHeight="16"
                    Margin="24,4,0,0" />
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
