<UserControl x:Class="MangaBinder.Controls.ImageSplitterPreview"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
			 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
			 xmlns:local="clr-namespace:MangaBinder.Controls"
			 mc:Ignorable="d" 
			 Focusable="True"
			 d:DesignHeight="450" d:DesignWidth="800"
			 SizeChanged="userControlSizeChanged">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="8" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="8" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<ui:Card Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Padding="4"
				 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
				 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
				 Opacity="{Binding PreviewCardOpacity, RelativeSource={RelativeSource AncestorType=local:ImageSplitterPreview}}">
		<Grid x:Name="RootGrid" ClipToBounds="True" Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
			  MouseWheel="rootGridMouseWheel"
			  MouseLeftButtonDown="rootGridMouseLeftButtonDown"
			  MouseMove="rootGridMouseMove"
			  LostMouseCapture="rootGridLostMouseCapture"
			  MouseLeftButtonUp="rootGridMouseLeftButtonUp">
			<Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" />
			<Canvas x:Name="GuideCanvas" />
		</Grid>
		</ui:Card>

		<ui:Card Grid.Row="2" Grid.Column="0" Padding="12,6"
				 HorizontalAlignment="Stretch" VerticalContentAlignment="Center">
			<TextBlock x:Name="ImageSizeText" FontSize="11"
					   HorizontalAlignment="Left" VerticalAlignment="Center"
					   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
		</ui:Card>

		<ui:Card Grid.Row="2" Grid.Column="2" Padding="8,4"
				 VerticalContentAlignment="Center">
			<ComboBox x:Name="ZoomComboBox" FontSize="11" MinWidth="90"
					  HorizontalAlignment="Right" IsEditable="False"
					  SelectionChanged="zoomComboBoxSelectionChanged">
				<ComboBox.ItemContainerStyle>
					<Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsCustom}" Value="True">
								<Setter Property="Visibility" Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</ComboBox.ItemContainerStyle>
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding DisplayText}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</ui:Card>
	</Grid>
</UserControl>
