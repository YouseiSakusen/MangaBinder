<UserControl x:Class="MangaBinder.Controls.PageLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:MangaBinder.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 左カラム -->
            <ColumnDefinition Width="{Binding RelativeSource={RelativeSource AncestorType=local:PageLayout}, Path=LeftColumnWidth, Mode=OneWay}" MinWidth="{Binding RelativeSource={RelativeSource AncestorType=local:PageLayout}, Path=LeftColumnMinWidth, Mode=OneWay}" />
            <!-- 中央カラム -->
            <ColumnDefinition Width="*" />
            <!-- 右カラム -->
            <ColumnDefinition Width="{Binding RelativeSource={RelativeSource AncestorType=local:PageLayout}, Path=RightColumnWidth, Mode=OneWay}" MinWidth="{Binding RelativeSource={RelativeSource AncestorType=local:PageLayout}, Path=RightColumnMinWidth, Mode=OneWay}" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <!-- 上部エリア（Auto） -->
            <RowDefinition Height="Auto" />
            <!-- 本文エリア（*） -->
            <RowDefinition Height="*" />
            <!-- フッタエリア（Auto） -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 左カラム - 上部 -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 中央カラム - 上部（アイキャッチカード + TopContent） -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- アイキャッチカード -->
                <ColumnDefinition Width="Auto" />
                <!-- 16px マージン -->
                <ColumnDefinition Width="16" />
                <!-- TopContent -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ─────────────────────────────────────────────────────── -->
            <!-- アイキャッチカード -->
            <!-- ─────────────────────────────────────────────────────── -->
            <ui:Card Grid.Column="0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- シンボルアイコン -->
                        <ColumnDefinition Width="Auto" />
                        <!-- テキスト領域 -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- シンボルアイコン -->
                    <ui:SymbolIcon
                        Grid.Column="0"
                        Symbol="{Binding RelativeSource={RelativeSource AncestorType=local:PageLayout}, Path=EyecatchSymbol, Mode=OneWay}"
                        FontSize="48"
                        Foreground="{DynamicResource BindingAccentBrush}"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center" />

                    <!-- テキスト領域 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- 見出し -->
                        <TextBlock
                            Text="{Binding RelativeSource={RelativeSource AncestorType=local:PageLayout}, Path=EyecatchTitle, Mode=OneWay}"
                            FontSize="11"
                            Margin="0,0,0,2"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <!-- 表示値 -->
                        <TextBlock
                            Text="{Binding RelativeSource={RelativeSource AncestorType=local:PageLayout}, Path=EyecatchValueText, Mode=OneWay}"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- TopContent -->
            <ContentPresenter Grid.Column="2" Content="{Binding RelativeSource={RelativeSource AncestorType=local:PageLayout}, Path=TopContent, Mode=OneWay}" />
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 右カラム - 上部 -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 左カラム - 本文 -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <ContentPresenter Grid.Column="0" Grid.Row="1" Content="{Binding RelativeSource={RelativeSource AncestorType=local:PageLayout}, Path=LeftContent, Mode=OneWay}" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 中央カラム - 本文 -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <ContentPresenter Grid.Column="1" Grid.Row="1" Content="{Binding RelativeSource={RelativeSource AncestorType=local:PageLayout}, Path=MainContent, Mode=OneWay}" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 右カラム - 本文 -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <ContentPresenter Grid.Column="2" Grid.Row="1" Content="{Binding RelativeSource={RelativeSource AncestorType=local:PageLayout}, Path=RightContent, Mode=OneWay}" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 左カラム - フッタ -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <ContentPresenter Grid.Column="0" Grid.Row="2" Content="{Binding RelativeSource={RelativeSource AncestorType=local:PageLayout}, Path=FooterLeftContent, Mode=OneWay}" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 中央カラム - フッタ -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <ContentPresenter Grid.Column="1" Grid.Row="2" Content="{Binding RelativeSource={RelativeSource AncestorType=local:PageLayout}, Path=FooterContent, Mode=OneWay}" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 右カラム - フッタ -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <ContentPresenter Grid.Column="2" Grid.Row="2" Content="{Binding RelativeSource={RelativeSource AncestorType=local:PageLayout}, Path=FooterRightContent, Mode=OneWay}" />
    </Grid>
</UserControl>
