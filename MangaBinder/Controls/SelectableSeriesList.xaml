<UserControl x:Class="MangaBinder.Controls.SelectableSeriesList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:extensions="clr-namespace:MangaBinder.Extensions"
             xmlns:controls="clr-namespace:MangaBinder.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="Transparent" HorizontalAlignment="Stretch">
        <!-- 作品一覧 ListView -->
        <ListView
            Name="SeriesListView"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding SelectedItem.Value}"
            SelectionMode="Single"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
            VirtualizingPanel.ScrollUnit="Item"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            BorderThickness="0"
            Background="Transparent">

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel
                        IsVirtualizing="True"
                        VirtualizationMode="Recycling" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <!-- コンパクトな作品カード -->
                    <Grid Height="120" Margin="8,4" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <!-- サムネイル -->
                            <ColumnDefinition Width="80" />
                            <!-- 作品情報 -->
                            <ColumnDefinition Width="*" />
                            <!-- 操作ボタン列 -->
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>

                        <!-- サムネイル -->
                        <Border
                            Grid.Column="0"
                            Width="80"
                            Height="112"
                            VerticalAlignment="Top"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="4"
                            ClipToBounds="True"
                            Margin="0,0,8,0">
                            <Image
                                Source="{Binding Series.Value, Converter={extensions:ThumbnailImageConverterExtension}}"
                                Width="80"
                                Height="112"
                                Stretch="UniformToFill"
                                RenderOptions.BitmapScalingMode="LowQuality" />
                        </Border>

                        <!-- 作品情報 -->
                        <Grid
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            VerticalAlignment="Top">

                            <Grid.RowDefinitions>
                                <!-- Row0: タイトル -->
                                <RowDefinition Height="Auto" />
                                <!-- Row1: 巻情報 + メモ -->
                                <RowDefinition Height="Auto" />
                                <!-- Row2: あらすじ -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Row0: タイトル -->
                            <TextBlock
                                Grid.Row="0"
                                Text="{Binding Series.Value.Title}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                MaxHeight="36"
                                TextWrapping="Wrap"
                                Margin="0,0,0,4" />

                            <!-- Row1: 巻情報 + メモ -->
                            <Grid
                                Grid.Row="1"
                                Margin="0,0,0,4">

                                <Grid.ColumnDefinitions>
                                    <!-- 巻情報 -->
                                    <ColumnDefinition Width="*" />
                                    <!-- メモアイコン -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 巻数情報 -->
                                <controls:SeriesVolumeStatus
                                    Grid.Column="0"
                                    DataContext="{Binding VolumeStatus.Value}" />

                                <!-- メモアイコン -->
                                <controls:SeriesMemo
                                    Grid.Column="1"
                                    DataContext="{Binding MemoStatus.Value}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Row2: あらすじ -->
                            <TextBlock
                                Grid.Row="2"
                                Text="{Binding Series.Value.Description}"
                                FontSize="11"
                                Opacity="0.6"
                                MaxHeight="48"
                                TextWrapping="Wrap"
                                TextTrimming="CharacterEllipsis"
                                Margin="0,0,0,4" />
                        </Grid>

                        <!-- 操作列：「▶」ボタン（ShowNavigateButton 時に表示） -->
                        <ui:Button
                            Grid.Column="2"
                            Appearance="Transparent"
                            Width="28"
                            Height="28"
                            Padding="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            MouseOverBackground="{DynamicResource ControlFillColorSecondaryBrush}"
                            MouseOverBorderBrush="Transparent"
                            ToolTip="編集"
                            Visibility="{Binding DataContext.ShowNavigateButton.Value, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                            CommandParameter="{Binding Series.Value}">
                            <TextBlock
                                Text="▶"
                                FontSize="12"
                                Opacity="0.6"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </ui:Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
    </Grid>
</UserControl>
