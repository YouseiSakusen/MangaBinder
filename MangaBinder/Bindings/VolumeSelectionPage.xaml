<Page x:Class="MangaBinder.Bindings.VolumeSelectionPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	  xmlns:local="clr-namespace:MangaBinder.Bindings"
	  xmlns:core="clr-namespace:MangaBinder.Bindings;assembly=MangaBinder.Core"
	  xmlns:shared="clr-namespace:MangaBinder.Bindings;assembly=MangaBinder.Shared"
	  xmlns:controls="clr-namespace:MangaBinder.Controls"
	  xmlns:bindings="clr-namespace:MangaBinder.Bindings"
	  xmlns:dd="urn:gong-wpf-dragdrop"
	  xmlns:behaviors="clr-namespace:MangaBinder.Behaviors"
	  xmlns:converters="clr-namespace:MangaBinder.Converters"
	  xmlns:tags="clr-namespace:MangaBinder.Tags"
	  xmlns:app="clr-namespace:MangaBinder"
	  mc:Ignorable="d"
	  d:DesignHeight="800" d:DesignWidth="1200"
	  Title="巻選択"
	  ui:NavigationView.HeaderContent="巻選択"
	  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	  ScrollViewer.CanContentScroll="False">

	<Page.Resources>

		<!-- PageViewModel 参照用BindingProxy（ContextMenuから使用） -->
		<tags:BindingProxy x:Key="VmProxy" Data="{Binding}" />

		<!-- NodeType ごとの Filled 属性（実フォルダ vs 圧縮内フォルダを区別） -->
		<converters:NodeTypeToFilledConverter x:Key="NodeTypeToFilledConverter" />

		<!-- 圧縮ファイルの数とサイズ合計を表示文字列に変換 -->
		<converters:ArchiveMaterialSummaryConverter x:Key="ArchiveMaterialSummaryConverter" />

		<!-- バイトサイズを表示用 MB/GB 文字列に変換 -->
		<converters:BytesToDisplaySizeConverter x:Key="BytesToDisplaySizeConverter" />

		<!-- TreeViewItem に IsExpanded をバインドするスタイル、行間を適度に広げる -->
		<Style TargetType="TreeViewItem">
			<Setter Property="IsExpanded" Value="{Binding IsExpanded.Value, Mode=TwoWay}" />
			<Setter Property="Padding" Value="4,3" />
			<Setter Property="MinHeight" Value="26" />
			<Setter Property="Margin" Value="0,0,0,2" />
		</Style>

		<!-- ノード表示テンプレート -->
		<HierarchicalDataTemplate x:Key="NodeTemplate"
								  DataType="{x:Type local:MaterialItemViewModel}"
								  ItemsSource="{Binding Children}">
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
				<!-- 右クリックメニュー：素材操作 -->
				<StackPanel.ContextMenu>
					<ContextMenu>
						<MenuItem
							Header="チェックを有効にする"
							Command="{Binding PlacementTarget.DataContext.EnableSelectionOverrideCommand,
											   RelativeSource={RelativeSource AncestorType=ContextMenu}}">
							<MenuItem.Style>
								<Style TargetType="MenuItem">
									<Setter Property="IsEnabled" Value="False" />
									<Style.Triggers>
										<MultiDataTrigger>
											<MultiDataTrigger.Conditions>
												<Condition Binding="{Binding PlacementTarget.DataContext.CanEnableSelectionOverride,
																			  RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True" />
												<Condition Binding="{Binding PlacementTarget.DataContext.IsSelectionOverrideEnabled.Value,
																			  RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False" />
											</MultiDataTrigger.Conditions>
											<Setter Property="IsEnabled" Value="True" />
										</MultiDataTrigger>
									</Style.Triggers>
								</Style>
							</MenuItem.Style>
						</MenuItem>
						<MenuItem
							Header="素材を削除..."
							Command="{Binding Data.DeleteMaterialCommand,
											   Source={StaticResource VmProxy}}"
							CommandParameter="{Binding PlacementTarget.DataContext,
													   RelativeSource={RelativeSource AncestorType=ContextMenu}}"
							IsEnabled="{Binding PlacementTarget.DataContext.CanDeleteMaterial,
												RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
					</ContextMenu>
				</StackPanel.ContextMenu>
				<!-- アイコン -->
				<controls:MaterialIcon
					ItemType="{Binding Material.ItemType}"
					Filled="{Binding Material, Converter={StaticResource NodeTypeToFilledConverter}}"
					VerticalAlignment="Center"
					Margin="0,0,5,0" />
				<!-- チェックボックス (Archive / 選択不可ノードは非表示) -->
				<CheckBox
					IsChecked="{Binding Material.IsChecked.Value, Mode=OneWay}"
					Focusable="False"
					IsTabStop="False"
					VerticalAlignment="Center"
					Margin="0,0,6,0"
					Command="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=DataContext.ToggleMaterialSelectionCommand}"
					CommandParameter="{Binding .}">
					<CheckBox.Style>
						<Style TargetType="CheckBox">
							<Style.Triggers>
								<DataTrigger Binding="{Binding CanCheck.Value}" Value="False">
									<Setter Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</CheckBox.Style>
				</CheckBox>
				<!-- ノード名 -->
				<TextBlock
					Text="{Binding Material.Name}"
					VerticalAlignment="Center" />
				<!-- Archive のみサイズ表示 -->
				<TextBlock
					VerticalAlignment="Center"
					Margin="6,0,0,0"
					FontSize="11"
					Opacity="0.65">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding Material.ItemType}" Value="{x:Static shared:MaterialItemType.Archive}">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
					<Run Text="（" /><Run Text="{Binding Material.FileSizeText}" /><Run Text="）" />
				</TextBlock>
			</StackPanel>
		</HierarchicalDataTemplate>

	</Page.Resources>

	<!-- ================================================================================== -->
	<!-- BindingPageLayout：製本工程共通レイアウト -->
	<!-- ================================================================================== -->
	<bindings:BindingPageLayout
		Margin="16,4,16,16"
		SeriesTitle="{Binding BindingSeries.SeriesTitle.Value}">

		<!-- PageLayout：3カラム + Eyecatch + Footer -->
		<controls:PageLayout
			LeftColumnWidth="250"
			LeftColumnMinWidth="250"
			MainColumnWidth="3*"
			RightColumnWidth="2*"
			IsMainRightSplitterEnabled="True"
			EyecatchSymbol="CheckboxArrowRight24"
			EyecatchTitle="製本後ZIPサイズ（推定）"
			EyecatchValueText="{Binding SelectedVolumeTotalImageBytes.Value, Converter={StaticResource BytesToDisplaySizeConverter}, Mode=OneWay}">

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- TopContent: 上部アクションボタン -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.TopContent>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="100" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="160" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<!-- Column 1: 圧縮ファイル比較 -->
					<controls:TopActionButton
						Grid.Column="1"
						HorizontalAlignment="Center"
						PrimaryText="圧縮ファイル比較"
						SecondaryLabel="圧縮ファイル数"
						SecondaryValue="{Binding MaterialArchiveCount.Value, StringFormat={}{0:N0}}"
						Symbol="ColumnDoubleCompare20"
						Command="{Binding ArchiveCompareCommand}" />

					<!-- Column 3: 素材フォルダを開く -->
					<controls:TopActionButton
						Grid.Column="3"
						HorizontalAlignment="Center"
						PrimaryText="素材フォルダを開く"
						SecondaryLabel="素材点数"
						SecondaryValue="{Binding MaterialTotalCount.Value, StringFormat={}{0:N0}}"
						Symbol="{x:Static app:AppSymbols.OpenMaterialFolder}"
						Command="{Binding OpenMaterialFolderCommand}" />
				</Grid>
			</controls:PageLayout.TopContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- LeftContent: 左パネル（作品情報 + 素材内訳） -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.LeftContent>
				<StackPanel
					Width="240"
					HorizontalAlignment="Center"
					VerticalAlignment="Top">

					<!-- 共通作品情報カード（MangaSeriesCard） -->
					<controls:MangaSeriesCard DataContext="{Binding BindingSeries.MangaSeriesCard}" />

					<!-- 巻選択画面固有：素材内訳Card -->
					<ui:Card
						Margin="0,5,0,0"
						Padding="12,12"
						VerticalAlignment="Top">
						<StackPanel>
							<TextBlock
								Text="素材内訳"
								FontSize="12"
								FontWeight="SemiBold"
								Foreground="{DynamicResource TextFillColorPrimaryBrush}"
								Margin="0,0,0,8" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<!-- フォルダ：第1行 -->
								<controls:MaterialIcon
									Grid.Row="0"
									Grid.Column="0"
									ItemType="Folder"
									Margin="0,0,4,0"
									VerticalAlignment="Center" />
								<TextBlock
									Grid.Row="0"
									Grid.Column="1"
									FontSize="11"
									Foreground="{DynamicResource TextFillColorPrimaryBrush}"
									VerticalAlignment="Center"
									Text="{Binding MaterialFolderCount.Value, StringFormat=フォルダ：{0}, Mode=OneWay}" />

								<!-- 圧縮ファイル：第2行 -->
								<controls:MaterialIcon
									Grid.Row="1"
									Grid.Column="0"
									ItemType="Archive"
									Margin="0,2,4,0"
									VerticalAlignment="Center" />
								<TextBlock
									Grid.Row="1"
									Grid.Column="1"
									FontSize="11"
									Foreground="{DynamicResource TextFillColorPrimaryBrush}"
									VerticalAlignment="Center"
									Margin="0,2,0,0">
									<TextBlock.Text>
										<MultiBinding Converter="{StaticResource ArchiveMaterialSummaryConverter}" Mode="OneWay">
											<Binding Path="MaterialArchiveCount.Value" />
											<Binding Path="MaterialArchiveTotalBytes.Value" />
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>

								<!-- EPUB：第3行 -->
								<controls:MaterialIcon
									Grid.Row="2"
									Grid.Column="0"
									ItemType="Epub"
									Margin="0,2,4,0"
									VerticalAlignment="Center" />
								<TextBlock
									Grid.Row="2"
									Grid.Column="1"
									FontSize="11"
									Foreground="{DynamicResource TextFillColorPrimaryBrush}"
									VerticalAlignment="Center"
									Margin="0,2,0,0"
									Text="{Binding MaterialEpubCount.Value, StringFormat=EPUB：{0}, Mode=OneWay}" />
							</Grid>
						</StackPanel>
					</ui:Card>
				</StackPanel>
			</controls:PageLayout.LeftContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- MainContent: 中央パネル（素材一覧ヘッダー + 素材TreeView） -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.MainContent>
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!-- Row 0: 素材一覧ヘッダー -->
					<StackPanel
						Grid.Row="0"
						Orientation="Horizontal"
						VerticalAlignment="Center"
						Margin="0,0,0,6">
						<ui:SymbolIcon
							Symbol="ImageMultiple16"
							FontSize="18"
							VerticalAlignment="Center"
							Foreground="{DynamicResource TextFillColorPrimaryBrush}"
							Margin="0,0,6,0" />
						<TextBlock
							Text="素材一覧"
							FontSize="12"
							FontWeight="SemiBold"
							VerticalAlignment="Center"
							Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
					</StackPanel>

					<!-- Row 1: 素材TreeView -->
					<TreeView
						Grid.Row="1"
						ItemsSource="{Binding MaterialItems}"
						ItemTemplate="{StaticResource NodeTemplate}"
						Background="Transparent"
						BorderThickness="0"
						Padding="0,0,40,0"
						InputMethod.PreferredImeState="Off"
						VirtualizingPanel.IsVirtualizing="False"
						ScrollViewer.VerticalScrollBarVisibility="Auto"
						ScrollViewer.HorizontalScrollBarVisibility="Auto"
						behaviors:VolumeSelectionInitializeBehavior.IsEnabled="True"
						behaviors:TreeViewSpaceKeyBehavior.IsEnabled="True"
						behaviors:TreeViewSpaceKeyBehavior.Command="{Binding ToggleMaterialSelectionCommand}"
						behaviors:TreeViewNodeClickToggleCheckBehavior.IsEnabled="True"
						behaviors:TreeViewNodeClickToggleCheckBehavior.Command="{Binding ToggleMaterialSelectionCommand}"
						behaviors:TreeViewRightClickSelectBehavior.IsEnabled="True"
						dd:DragDrop.IsDragSource="True"
						dd:DragDrop.UseDefaultDragAdorner="True"
						dd:DragDrop.UseDefaultEffectDataTemplate="True"
						dd:DragDrop.DragHandler="{Binding MaterialItemDragHandler}" />
				</Grid>
			</controls:PageLayout.MainContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- RightContent: 右パネル（2行1列: 選択巻一覧 + 設定領域） -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.RightContent>
				<Border Margin="12,0,0,0" Padding="0">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="3*" />
							<RowDefinition Height="1*" />
						</Grid.RowDefinitions>

						<!-- ─ Row 0: 選択巻一覧 ─ -->
						<Grid Grid.Row="0">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

						<!-- ─ Row 0: 製本対象巻ヘッダー ─ -->
						<StackPanel
							Grid.Row="0"
							Orientation="Horizontal"
							VerticalAlignment="Center"
							Margin="0,0,0,6">
							<ui:SymbolIcon
								Symbol="BoxMultipleCheckmark20"
								FontSize="18"
								VerticalAlignment="Center"
								Foreground="{DynamicResource TextFillColorPrimaryBrush}"
								Margin="0,0,6,0" />
							<TextBlock
								Text="製本対象巻"
								FontSize="12"
								FontWeight="SemiBold"
								VerticalAlignment="Center"
								Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
						</StackPanel>

						<!-- ─ Row 1: ヘッダー行 ─ -->
						<Grid Grid.Row="1" Margin="0,0,0,2">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="50" />
								<ColumnDefinition Width="28" />
								<ColumnDefinition Width="74" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="巻" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Padding="4,0,0,0" />
							<TextBlock Grid.Column="2" Text="ファイル数" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Padding="4,0,0,0" HorizontalAlignment="Right" />
							<TextBlock Grid.Column="3" Text="名前" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Padding="4,0,0,0" />
						</Grid>

						<!-- ─ Row 2: ListViewデータ行 ─ -->
						<ListView
							Grid.Row="2"
							ItemsSource="{Binding BindingVolumes}"
							SelectedItem="{Binding SelectedBindingVolume.Value, Mode=TwoWay}"
							BorderThickness="0"
							Background="Transparent"
							Foreground="{DynamicResource TextFillColorPrimaryBrush}"
							behaviors:VolumeSelectionInitializeBehavior.IsEnabled="True"
							dd:DragDrop.IsDragSource="True"
							dd:DragDrop.IsDropTarget="True"
							dd:DragDrop.DropHandler="{Binding BindingVolumeDropHandler}"
							dd:DragDrop.UseDefaultDragAdorner="True"
							dd:DragDrop.UseDefaultEffectDataTemplate="True"
							behaviors:ListViewVolumeNumberTabNavigationBehavior.IsEnabled="True">
							<ListView.InputBindings>
								<KeyBinding Key="Delete" Command="{Binding RemoveSelectedBindingVolumeCommand}" />
							</ListView.InputBindings>
							<ListView.ItemContainerStyle>
								<Style TargetType="ListViewItem">
									<Setter Property="Padding" Value="0" />
									<Setter Property="MinHeight" Value="26" />
									<Setter Property="HorizontalContentAlignment" Value="Stretch" />
									<Setter Property="Background" Value="Transparent" />
									<Setter Property="BorderThickness" Value="0" />
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="ListViewItem">
												<Border
													x:Name="Bd"
													Background="Transparent"
													BorderThickness="0,0,0,1"
													BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
													Padding="0,2">
													<ContentPresenter
														Content="{TemplateBinding Content}"
														ContentTemplate="{TemplateBinding ContentTemplate}"
														ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
														ContentStringFormat="{TemplateBinding ContentStringFormat}" />
												</Border>
												<ControlTemplate.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
													</Trigger>
													<DataTrigger
														Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}"
														Value="True">
														<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
													</DataTrigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
								</Style>
							</ListView.ItemContainerStyle>
							<ListView.ItemTemplate>
								<DataTemplate>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="50" />
											<ColumnDefinition Width="28" />
											<ColumnDefinition Width="74" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>

										<!-- Column 0: 巻番号 -->
										<ui:TextBox
											Grid.Column="0"
											Width="42"
											HorizontalAlignment="Right"
											Text="{Binding VolumeNumber.Value, TargetNullValue='?', StringFormat={}{0:0.#}, UpdateSourceTrigger=LostFocus}"
											BorderThickness="0"
											Background="Transparent"
											TextAlignment="Right"
											Padding="0,0,4,0"
											FontSize="12"
											VerticalAlignment="Center"
											ClearButtonEnabled="False"
											behaviors:SelectAllOnFocusBehavior.IsEnabled="True" />

										<!-- Column 1: 種別アイコン -->
										<controls:MaterialIcon
											Grid.Column="1"
											ItemType="{Binding DisplayItemType}"
											HorizontalAlignment="Center"
											VerticalAlignment="Center" />

										<!-- Column 2: ファイル数 -->
										<TextBlock
											Grid.Column="2"
											Text="{Binding FileCountText}"
											FontSize="12"
											HorizontalAlignment="Right"
											Padding="0,0,4,0"
											VerticalAlignment="Center" />

										<!-- Column 3: 名前 -->
										<TextBlock
											Grid.Column="3"
											Text="{Binding Name}"
											FontSize="12"
											Padding="4,0,0,0"
											TextTrimming="CharacterEllipsis"
											VerticalAlignment="Center"
											ToolTip="{Binding Name}" />
									</Grid>
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>

						<!-- ─ Row 3: ドラッグして除外領域 ─ -->
						<ui:Card
							Grid.Row="3"
							Padding="12,8"
							Margin="0,8,3,0">
							<Border
								Padding="0"
								BorderThickness="0"
								Background="Transparent"
								dd:DragDrop.IsDropTarget="True"
								dd:DragDrop.DropHandler="{Binding BindingVolumeRemoveDropHandler}">
								<TextBlock
									Text="🗑 ここへドラッグして除外"
									FontSize="11"
									HorizontalAlignment="Center"
									Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
							</Border>
						</ui:Card>
						</Grid>

						<!-- ─ Row 1: 設定領域 ─ -->
						<ScrollViewer
							Grid.Row="1"
							VerticalScrollBarVisibility="Auto"
							HorizontalScrollBarVisibility="Disabled">

							<!-- 外側Card：画像展開設定グループ -->
							<ui:Card Style="{StaticResource SettingsGroupCardStyle}" Margin="0,0,3,0">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="64" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>

									<!-- Row 0: グループ見出し -->
									<StackPanel Grid.Row="0" VerticalAlignment="Center">
										<TextBlock
											Text="画像展開設定"
											Style="{StaticResource SettingsGroupTitleStyle}" />
										<TextBlock
											Text="次画面の画像展開の動作を設定します"
											Style="{StaticResource SettingsGroupDescriptionStyle}" />
									</StackPanel>

									<!-- Row 1: 個別設定Cards -->
									<Grid Grid.Row="1">
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
										</Grid.RowDefinitions>

										<!-- Row 0: 設定1 - 画像展開時の動作 -->
										<ui:Card Grid.Row="0" Style="{StaticResource SettingsItemCardStyle}">
											<Grid Height="44">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="16" />
													<ColumnDefinition Width="Auto" />
												</Grid.ColumnDefinitions>

												<!-- Column 0: 項目名・説明 -->
												<StackPanel Grid.Column="0">
													<TextBlock
														Text="画像展開時の動作"
												Style="{StaticResource SettingsItemTitleStyle}" />
													<TextBlock
														Text="画像展開先の動作を選択します"
												Style="{StaticResource SettingsItemDescriptionStyle}" />
												</StackPanel>

												<!-- Column 2: ComboBox -->
												<ComboBox
													Grid.Column="2"
													ItemsSource="{Binding ImageExpansionOptions}"
													DisplayMemberPath="Label"
													SelectedValuePath="Method"
													SelectedValue="{Binding ImageExpansionMethod.Value, Mode=TwoWay}"
													IsEnabled="{Binding HasExistingWorkFolder.Value}"
													Width="240"
													VerticalAlignment="Center"
													HorizontalAlignment="Right" />
											</Grid>
										</ui:Card>

										<!-- Row 1: 設定2 - 巻フォルダ名の桁数 -->
										<ui:Card Grid.Row="1" Style="{StaticResource SettingsItemCardStyle}" Margin="0,6,0,0">
											<Grid Height="44">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="16" />
													<ColumnDefinition Width="Auto" />
												</Grid.ColumnDefinitions>

												<!-- Column 0: 項目名・説明 -->
												<StackPanel Grid.Column="0">
													<TextBlock
														Text="巻フォルダ名の桁数"
												Style="{StaticResource SettingsItemTitleStyle}" />
													<TextBlock
														Text="巻の番号桁数を指定します"
												Style="{StaticResource SettingsItemDescriptionStyle}" />
												</StackPanel>

												<!-- Column 2: ComboBox -->
												<ComboBox
													Grid.Column="2"
													ItemsSource="{Binding VolumeFolderDigitOptions}"
													SelectedValuePath="Digits"
													SelectedValue="{Binding VolumeFolderDigits.Value, Mode=TwoWay}"
													Width="180"
													VerticalAlignment="Center"
													HorizontalAlignment="Right">
													<ComboBox.ItemTemplate>
														<DataTemplate>
															<StackPanel Orientation="Horizontal">
																<TextBlock
																	Text="{Binding Label}"
																	Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
																<TextBlock
																	Text="{Binding ExampleText}"
																	Foreground="{DynamicResource TextFillColorSecondaryBrush}"
																	Margin="4,0,0,0" />
															</StackPanel>
														</DataTemplate>
													</ComboBox.ItemTemplate>
												</ComboBox>
											</Grid>
										</ui:Card>
									</Grid>
								</Grid>
							</ui:Card>

						</ScrollViewer>
					</Grid>
				</Border>
			</controls:PageLayout.RightContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- FooterLeftContent: 戻るボタン -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.FooterLeftContent>
				<ui:Button
					Style="{StaticResource FooterButtonStyle}"
					HorizontalAlignment="Left"
					Content="戻る"
					Command="{Binding GoBackCommand}" />
			</controls:PageLayout.FooterLeftContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- FooterContent: 製本をキャンセルボタン（UI確認用） -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.FooterContent>
				<ui:Button
					Style="{StaticResource FooterButtonStyle}"
					HorizontalAlignment="Right" 
					Content="製本をキャンセル"
					Command="{Binding CancelCommand}" />
			</controls:PageLayout.FooterContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- FooterRightContent: 次へボタン -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.FooterRightContent>
				<ui:Button
					Style="{StaticResource FooterPrimaryButtonStyle}"
					HorizontalAlignment="Right"
					Content="次へ"
					IsEnabled="{Binding CanGoNext.Value}"
					Command="{Binding GoNextCommand}" />
			</controls:PageLayout.FooterRightContent>
		</controls:PageLayout>

	</bindings:BindingPageLayout>

</Page>
