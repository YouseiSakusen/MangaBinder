<Page x:Class="MangaBinder.Bindings.VolumeSelectionPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	  xmlns:local="clr-namespace:MangaBinder.Bindings"
	  xmlns:core="clr-namespace:MangaBinder.Bindings;assembly=MangaBinder.Core"
	  xmlns:shared="clr-namespace:MangaBinder.Bindings;assembly=MangaBinder.Shared"
	  xmlns:controls="clr-namespace:MangaBinder.Controls"
	  xmlns:bindings="clr-namespace:MangaBinder.Bindings"
	  xmlns:dd="urn:gong-wpf-dragdrop"
	  xmlns:behaviors="clr-namespace:MangaBinder.Behaviors"
	  xmlns:converters="clr-namespace:MangaBinder.Converters"
	  mc:Ignorable="d"
	  d:DesignHeight="800" d:DesignWidth="1200"
	  Title="巻選択"
	  ui:NavigationView.HeaderContent="巻選択"
	  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	  ScrollViewer.CanContentScroll="False">

	<Page.Resources>

		<!-- NodeType ごとの SymbolIcon Symbol 名 -->
		<converters:NodeTypeToSymbolConverter x:Key="NodeTypeToSymbolConverter" />

		<!-- NodeType ごとのアイコン色 -->
		<converters:NodeTypeToColorConverter x:Key="NodeTypeToColorConverter" />

		<!-- NodeType ごとの Filled 属性（実フォルダ vs 圧縮内フォルダを区別） -->
		<converters:NodeTypeToFilledConverter x:Key="NodeTypeToFilledConverter" />

		<!-- TreeViewItem に IsExpanded をバインドするスタイル、行間を適度に広げる -->
		<Style TargetType="TreeViewItem">
			<Setter Property="IsExpanded" Value="{Binding IsExpanded.Value, Mode=TwoWay}" />
			<Setter Property="Padding" Value="4,3" />
			<Setter Property="MinHeight" Value="26" />
			<Setter Property="Margin" Value="0,0,0,2" />
		</Style>

		<!-- ノード表示テンプレート -->
		<HierarchicalDataTemplate x:Key="NodeTemplate"
								  DataType="{x:Type core:MaterialVolumeNode}"
								  ItemsSource="{Binding Children}">
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
				<!-- 右クリックメニュー：選択不可ノードを一時的に選択可能にする -->
				<StackPanel.ContextMenu>
					<ContextMenu>
						<ContextMenu.Style>
							<Style TargetType="ContextMenu">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding PlacementTarget.DataContext.CanCheck.Value,
																	RelativeSource={RelativeSource Self}}"
												 Value="False">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</ContextMenu.Style>
						<MenuItem
							Header="選択可能にする"
							Command="{Binding PlacementTarget.DataContext.EnableSelectionOverrideCommand,
											  RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
					</ContextMenu>
				</StackPanel.ContextMenu>
				<!-- アイコン -->
				<ui:SymbolIcon
					Symbol="{Binding NodeType, Converter={StaticResource NodeTypeToSymbolConverter}}"
					Filled="{Binding ., Converter={StaticResource NodeTypeToFilledConverter}}"
					FontSize="16"
					Foreground="{Binding NodeType, Converter={StaticResource NodeTypeToColorConverter}}"
					VerticalAlignment="Center"
					Margin="0,0,5,0" />
				<!-- チェックボックス (Archive / 選択不可ノードは非表示) -->
				<CheckBox
					IsChecked="{Binding IsChecked.Value, Mode=TwoWay}"
					Focusable="False"
					IsTabStop="False"
					VerticalAlignment="Center"
					Margin="0,0,6,0">
					<CheckBox.Style>
						<Style TargetType="CheckBox">
							<Style.Triggers>
								<DataTrigger Binding="{Binding CanCheck.Value}" Value="False">
									<Setter Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</CheckBox.Style>
				</CheckBox>
				<!-- ノード名 -->
				<TextBlock
					Text="{Binding Name.Value}"
					VerticalAlignment="Center" />
				<!-- Archive のみサイズ表示 -->
				<TextBlock
					VerticalAlignment="Center"
					Margin="6,0,0,0"
					FontSize="11"
					Opacity="0.65">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding NodeType}" Value="{x:Static shared:MaterialItemType.Archive}">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
					<Run Text="（" /><Run Text="{Binding FileSizeText}" /><Run Text="）" />
				</TextBlock>
			</StackPanel>
		</HierarchicalDataTemplate>

	</Page.Resources>

	<!-- ================================================================================== -->
	<!-- BindingPageLayout：製本工程共通レイアウト -->
	<!-- ================================================================================== -->
	<bindings:BindingPageLayout
		Margin="16,4,16,16"
		SeriesTitle="{Binding SeriesTitle.Value}">

		<!-- PageLayout：3カラム + Eyecatch + Footer -->
		<controls:PageLayout
			LeftColumnWidth="250"
			LeftColumnMinWidth="250"
			MainColumnWidth="3*"
			RightColumnWidth="2*"
			IsMainRightSplitterEnabled="True"
			EyecatchSymbol="CheckboxArrowRight24"
			EyecatchTitle="製本後ZIPサイズ（推定）"
			EyecatchValueText="{Binding SelectedVolumeSummaryText.Value}">

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- TopContent: 上部設定Card群（素材展開方法 + 巻フォルダ名） -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.TopContent>
				<StackPanel Orientation="Horizontal">
					<!-- Card 1：画像の展開 -->
					<ui:Card Padding="12,12" Margin="0,0,50,8">
						<StackPanel>
							<TextBlock
								Text="素材展開先一時フォルダへの展開"
								FontSize="12"
								FontWeight="SemiBold"
								Foreground="{DynamicResource TextFillColorSecondaryBrush}"
								Margin="0,0,0,6" />
							<ComboBox
								ItemsSource="{Binding ImageExpansionOptions}"
								SelectedIndex="{Binding ImageExpansionMethod.Value, Mode=TwoWay}"
								IsEnabled="{Binding HasExistingWorkFolder.Value}"
								Width="340">
							</ComboBox>
						</StackPanel>
					</ui:Card>

					<!-- Card 2：巻フォルダ名 -->
					<ui:Card Padding="10,8">
						<StackPanel>
							<TextBlock
								Text="巻フォルダ名"
								FontSize="12"
								FontWeight="SemiBold"
								Foreground="{DynamicResource TextFillColorPrimaryBrush}"
								Margin="0,0,0,6" />
							<ComboBox
								ItemsSource="{Binding VolumeFolderDigitOptions}"
								SelectedValuePath="Digits"
								SelectedValue="{Binding VolumeFolderDigits.Value, Mode=TwoWay}"
								Width="240">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<TextBlock
												Text="{Binding Label}"
												Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
											<TextBlock
												Text="{Binding ExampleText}"
												Foreground="{DynamicResource TextFillColorSecondaryBrush}"
												Margin="4,0,0,0" />
										</StackPanel>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</StackPanel>
					</ui:Card>
				</StackPanel>
			</controls:PageLayout.TopContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- LeftContent: 左パネル（作品情報 + 素材内訳） -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.LeftContent>
				<StackPanel
					Width="240"
					HorizontalAlignment="Center"
					VerticalAlignment="Top">

					<!-- 共通作品情報カード（MangaSeriesCard） -->
					<controls:MangaSeriesCard DataContext="{Binding MangaSeriesCard}" />

					<!-- 巻選択画面固有：素材内訳Card -->
					<ui:Card
						Margin="0,5,0,0"
						Padding="6,6"
						VerticalAlignment="Top">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<!-- フォルダ：第1行 -->
							<ui:SymbolIcon
								Grid.Row="0"
								Grid.Column="0"
								Symbol="Folder24"
								Filled="True"
								FontSize="14"
								Foreground="#C58A00"
								Margin="0,0,4,0"
								VerticalAlignment="Center" />
							<TextBlock
								Grid.Row="0"
								Grid.Column="1"
								FontSize="11"
								Foreground="{DynamicResource TextFillColorPrimaryBrush}"
								VerticalAlignment="Center"
								Text="{Binding MaterialFolderCountText.Value, Mode=OneWay}" />

							<!-- 圧縮ファイル：第2行 -->
							<ui:SymbolIcon
								Grid.Row="1"
								Grid.Column="0"
								Symbol="Archive24"
								Filled="True"
								FontSize="14"
								Foreground="#6E87A8"
								Margin="0,2,4,0"
								VerticalAlignment="Center" />
							<TextBlock
								Grid.Row="1"
								Grid.Column="1"
								FontSize="11"
								Foreground="{DynamicResource TextFillColorPrimaryBrush}"
								VerticalAlignment="Center"
								Margin="0,2,0,0"
								Text="{Binding MaterialArchiveCountText.Value, Mode=OneWay}" />

							<!-- EPUB：第3行 -->
							<ui:SymbolIcon
								Grid.Row="2"
								Grid.Column="0"
								Symbol="Book24"
								Filled="True"
								FontSize="14"
								Foreground="#2E9F55"
								Margin="0,2,4,0"
								VerticalAlignment="Center" />
							<TextBlock
								Grid.Row="2"
								Grid.Column="1"
								FontSize="11"
								Foreground="{DynamicResource TextFillColorPrimaryBrush}"
								VerticalAlignment="Center"
								Margin="0,2,0,0"
								Text="{Binding MaterialEpubCountText.Value, Mode=OneWay}" />
						</Grid>
					</ui:Card>
				</StackPanel>
			</controls:PageLayout.LeftContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- MainContent: 中央パネル（素材TreeView） -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.MainContent>
				<TreeView
					ItemsSource="{Binding RootNodes}"
					ItemTemplate="{StaticResource NodeTemplate}"
					Background="Transparent"
					BorderThickness="0"
					Padding="0,0,40,0"
					VirtualizingPanel.IsVirtualizing="False"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
					ScrollViewer.HorizontalScrollBarVisibility="Auto"
					behaviors:TreeViewSelectedItemBehavior.SelectedItem="{Binding SelectedNode.Value, Mode=TwoWay}"
					behaviors:TreeViewSpaceKeyBehavior.IsEnabled="True"
					behaviors:TreeViewNodeClickToggleCheckBehavior.IsEnabled="True"
					dd:DragDrop.IsDragSource="True"
					dd:DragDrop.UseDefaultDragAdorner="True"
					dd:DragDrop.UseDefaultEffectDataTemplate="True"
					dd:DragDrop.DragHandler="{Binding TreeViewDragHandler}" />
			</controls:PageLayout.MainContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- RightContent: 右パネル（選択巻リスト） -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.RightContent>
				<Border Margin="12,0,0,0" Padding="0">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<!-- ─ Row 0: 新規製本表示 ─ -->
						<TextBlock
							Grid.Row="0"
							Text="🆕 新規製本"
							FontSize="12"
							Foreground="{DynamicResource TextFillColorPrimaryBrush}"
							Margin="0,0,0,6">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility" Value="Collapsed" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding HasExistingWorkFolder.Value}" Value="False">
											<Setter Property="Visibility" Value="Visible" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>

						<!-- ─ Row 1: ヘッダー行 ─ -->
						<Grid Grid.Row="1" Margin="0,0,0,2">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="50" />
								<ColumnDefinition Width="28" />
								<ColumnDefinition Width="74" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="巻" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Padding="4,0,0,0" />
							<TextBlock Grid.Column="2" Text="ファイル数" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Padding="4,0,0,0" HorizontalAlignment="Right" />
							<TextBlock Grid.Column="3" Text="名前" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Padding="4,0,0,0" />
						</Grid>

						<!-- ─ Row 2: ListViewデータ行 ─ -->
						<ListView
							Grid.Row="2"
							ItemsSource="{Binding BindingQueueItems}"
							SelectedItem="{Binding SelectedBindingQueueItem.Value, Mode=TwoWay}"
							BorderThickness="0"
							Background="Transparent"
							Foreground="{DynamicResource TextFillColorPrimaryBrush}"
							dd:DragDrop.IsDragSource="True"
							dd:DragDrop.IsDropTarget="True"
							dd:DragDrop.DropHandler="{Binding DropHandler}"
							dd:DragDrop.UseDefaultDragAdorner="True"
							dd:DragDrop.UseDefaultEffectDataTemplate="True"
							behaviors:ListViewVolumeNumberTabNavigationBehavior.IsEnabled="True">
							<ListView.InputBindings>
								<KeyBinding Key="Delete" Command="{Binding RemoveSelectedQueueItemCommand}" />
							</ListView.InputBindings>
							<ListView.ItemContainerStyle>
								<Style TargetType="ListViewItem">
									<Setter Property="Padding" Value="0" />
									<Setter Property="MinHeight" Value="26" />
									<Setter Property="HorizontalContentAlignment" Value="Stretch" />
									<Setter Property="Background" Value="Transparent" />
									<Setter Property="BorderThickness" Value="0" />
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="ListViewItem">
												<Border
													x:Name="Bd"
													Background="Transparent"
													BorderThickness="0,0,0,1"
													BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
													Padding="0,2">
													<ContentPresenter
														Content="{TemplateBinding Content}"
														ContentTemplate="{TemplateBinding ContentTemplate}"
														ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
														ContentStringFormat="{TemplateBinding ContentStringFormat}" />
												</Border>
												<ControlTemplate.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
													</Trigger>
													<DataTrigger
														Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}"
														Value="True">
														<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
													</DataTrigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
								</Style>
							</ListView.ItemContainerStyle>
							<ListView.ItemTemplate>
								<DataTemplate>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="50" />
											<ColumnDefinition Width="28" />
											<ColumnDefinition Width="74" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>

										<!-- Column 0: 巻番号 -->
										<ui:TextBox
											Grid.Column="0"
											Width="42"
											HorizontalAlignment="Right"
											Text="{Binding VolumeNumber.Value, TargetNullValue='?', StringFormat={}{0:0.#}, UpdateSourceTrigger=LostFocus}"
											BorderThickness="0"
											Background="Transparent"
											TextAlignment="Right"
											Padding="0,0,4,0"
											FontSize="12"
											VerticalAlignment="Center" />

										<!-- Column 1: 種別アイコン -->
										<ui:SymbolIcon
											Grid.Column="1"
											Symbol="{Binding SourceNode.NodeType, Converter={StaticResource NodeTypeToSymbolConverter}}"
											Filled="{Binding SourceNode, Converter={StaticResource NodeTypeToFilledConverter}}"
											Foreground="{Binding SourceNode.NodeType, Converter={StaticResource NodeTypeToColorConverter}}"
											FontSize="16"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											ToolTip="{Binding SourceTypeText}" />

										<!-- Column 2: ファイル数 -->
										<TextBlock
											Grid.Column="2"
											Text="{Binding FileCountText}"
											FontSize="12"
											HorizontalAlignment="Right"
											Padding="0,0,4,0"
											VerticalAlignment="Center" />

										<!-- Column 3: 名前 -->
										<TextBlock
											Grid.Column="3"
											Text="{Binding DisplayName}"
											FontSize="12"
											Padding="4,0,0,0"
											TextTrimming="CharacterEllipsis"
											VerticalAlignment="Center"
											ToolTip="{Binding DisplayName}" />
									</Grid>
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>

						<!-- ─ Row 3: ドラッグして除外領域 ─ -->
						<Border
							Grid.Row="3"
							Padding="8,6"
							BorderThickness="0"
							Background="Transparent"
							Margin="0,8,0,0"
							dd:DragDrop.IsDropTarget="True"
							dd:DragDrop.DropHandler="{Binding RemoveDropHandler}">
							<TextBlock
								Text="🗑 ここへドラッグして除外"
								FontSize="11"
								HorizontalAlignment="Center"
								Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
						</Border>
					</Grid>
				</Border>
			</controls:PageLayout.RightContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- FooterLeftContent: 戻るボタン -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.FooterLeftContent>
				<ui:Button
					Height="48"
					MinWidth="140"
					VerticalAlignment="Center"
					HorizontalAlignment="Left"
					Command="{Binding GoBackCommand}">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
						<ui:SymbolIcon Symbol="ChevronLeft16" FontSize="18" Margin="0,0,6,0" />
						<TextBlock Text="戻る" VerticalAlignment="Center" />
					</StackPanel>
				</ui:Button>
			</controls:PageLayout.FooterLeftContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- FooterContent: 次へボタン（右寄せ） -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.FooterContent>
				<ui:Button
					Height="48"
					MinWidth="140"
					VerticalAlignment="Center"
					HorizontalAlignment="Right"
					Appearance="Primary"
					IsEnabled="{Binding CanGoNext.Value}"
					Command="{Binding GoNextCommand}">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
						<TextBlock Text="次へ" VerticalAlignment="Center" Margin="0,0,6,0" />
						<ui:SymbolIcon Symbol="ChevronRight16" FontSize="18" />
					</StackPanel>
				</ui:Button>
			</controls:PageLayout.FooterContent>
		</controls:PageLayout>

	</bindings:BindingPageLayout>

</Page>
