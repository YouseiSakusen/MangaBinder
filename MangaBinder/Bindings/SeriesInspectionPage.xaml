<Page x:Class="MangaBinder.Bindings.SeriesInspectionPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	  xmlns:local="clr-namespace:MangaBinder.Bindings"
	  xmlns:core="clr-namespace:MangaBinder.Bindings.Inspection;assembly=MangaBinder.Core"
	  xmlns:controls="clr-namespace:MangaBinder.Controls"
	  mc:Ignorable="d"
	  x:Name="ThisPage"
	  d:DesignHeight="800" d:DesignWidth="1200"
	  Title="製本前確認"
	  ui:NavigationView.HeaderContent="製本前確認"
	  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	  ScrollViewer.CanContentScroll="False">

	<Page.Resources>

		<!-- 巻カード ItemTemplate -->
		<DataTemplate x:Key="VolumeCardTemplate" DataType="{x:Type core:VolumeInspectionResult}">
			<ui:Card Margin="0,0,0,6" Padding="12,8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!-- Row0：巻名 + 画像ファイル数 -->
					<Grid Grid.Row="0" Margin="0,0,0,4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							Text="{Binding VolumeName}"
							FontSize="13"
							FontWeight="SemiBold"
							VerticalAlignment="Center" />
						<TextBlock
							Grid.Column="1"
							FontSize="11"
							VerticalAlignment="Center"
							Foreground="{DynamicResource TextFillColorSecondaryBrush}">
							<Run Text="画像ファイル数: " />
							<Run Text="{Binding ImageFileCount, Mode=OneWay}" />
						</TextBlock>
					</Grid>

					<!-- Row1：横長画像行（問題ありの場合のみ） -->
					<Grid Grid.Row="1" Margin="0,0,0,2">
						<Grid.Style>
							<Style TargetType="Grid">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding HasLandscapeImages}" Value="True">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Grid.Style>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							FontSize="11"
							VerticalAlignment="Center"
							Foreground="{DynamicResource SystemFillColorCautionBrush}">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Text" Value="横長画像あり" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding AllLandscape}" Value="True">
											<Setter Property="Text" Value="全て横長画像" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
						<ui:Button
							x:Name="VolumeMenuButton"
							Grid.Column="1"
							Content="…"
							FontSize="11"
							Padding="6,1"
							Tag="{Binding}"
							Click="VolumeMenuButton_Click">
							<ui:Button.Resources>
								<ContextMenu x:Key="VolumeContextMenu">
									<MenuItem
										Header="見開き分割"
										Command="{Binding DataContext.OpenVolumeThumbnailsCommand,
											Source={x:Reference ThisPage}}"
										CommandParameter="{Binding PlacementTarget.Tag,
											RelativeSource={RelativeSource AncestorType=ContextMenu}}">
										<MenuItem.Icon>
											<ui:SymbolIcon Symbol="BookOpen24" />
										</MenuItem.Icon>
									</MenuItem>
								</ContextMenu>
							</ui:Button.Resources>
						</ui:Button>
					</Grid>

					<!-- Row2：ファイル形式混在（問題ありの場合のみ） -->
					<TextBlock
						Grid.Row="2"
						Text="ファイル形式混在あり"
						FontSize="11"
						Foreground="{DynamicResource SystemFillColorCautionBrush}"
						Margin="0,0,0,2">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding HasMixedFormats}" Value="True">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>

					<!-- Row3：ファイル名文字数不揃い（問題ありの場合のみ） -->
					<TextBlock
						Grid.Row="3"
						Text="ファイル名文字数: 不揃い"
						FontSize="11"
						Foreground="{DynamicResource SystemFillColorCautionBrush}"
						Margin="0,0,0,2">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding HasIrregularFileNameLength}" Value="True">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>

					<!-- Row4：サブフォルダ展開方式（サブフォルダが存在する場合のみ） -->
					<Grid Grid.Row="4" Margin="0,2,0,0">
						<Grid.Style>
							<Style TargetType="Grid">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding HasSubFolders}" Value="True">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Grid.Style>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							Text="サブフォルダ: "
							FontSize="11"
							VerticalAlignment="Center"
							Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
						<ComboBox
							Grid.Column="1"
							FontSize="11"
							Padding="6,3"
							ItemsSource="{Binding DataContext.SubFolderModeItems,
								RelativeSource={RelativeSource AncestorType=ListView}}"
							SelectedIndex="{Binding SubFolderModeIndex}" />
					</Grid>

				</Grid>
			</ui:Card>
		</DataTemplate>

	</Page.Resources>

	<!-- ════════════════════════════════════════════════════════════════ -->
	<!-- BindingPageLayout：製本工程共通レイアウト -->
	<!-- ════════════════════════════════════════════════════════════════ -->
	<local:BindingPageLayout
		Margin="16,4,16,16"
		SeriesTitle="{Binding SeriesTitle.Value}">

		<!-- PageLayout：3カラム + Eyecatch + Footer -->
		<controls:PageLayout
			LeftColumnWidth="250"
			LeftColumnMinWidth="250"
			MainColumnWidth="2*"
			RightColumnWidth="*"
			IsMainRightSplitterEnabled="True"
			EyecatchSymbol="ClipboardCheckmark24"
			EyecatchTitle="製本対象"
			EyecatchValueText="{Binding SelectedVolumeCountText.Value}">

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- LeftContent: 左パネル（作品情報） -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.LeftContent>
				<StackPanel
					Width="240"
					HorizontalAlignment="Center"
					VerticalAlignment="Top">

					<!-- 共通作品情報カード（MangaSeriesCard） -->
					<controls:MangaSeriesCard DataContext="{Binding MangaSeriesCard}" />
				</StackPanel>
			</controls:PageLayout.LeftContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- MainContent: 中央パネル（検査結果一覧） -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.MainContent>
				<ListView
					ItemsSource="{Binding InspectionResults}"
					ItemTemplate="{StaticResource VolumeCardTemplate}"
					Background="Transparent"
					BorderThickness="0"
					VirtualizingPanel.IsVirtualizing="True"
					VirtualizingPanel.VirtualizationMode="Recycling"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
					HorizontalContentAlignment="Stretch">
					<ListView.ItemContainerStyle>
						<Style TargetType="ListViewItem">
							<Setter Property="Padding" Value="0" />
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
							<Setter Property="Background" Value="Transparent" />
							<Setter Property="BorderThickness" Value="0" />
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="ListViewItem">
										<ContentPresenter />
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ListView.ItemContainerStyle>
				</ListView>
			</controls:PageLayout.MainContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- RightContent: 右パネル（製本後zipファイル設定） -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.RightContent>
				<ui:Card Margin="0,0,0,0" Padding="12,8" VerticalAlignment="Top">
					<StackPanel MaxWidth="720">

						<!-- カードタイトル -->
						<TextBlock
							Text="製本後zipファイル設定"
							FontSize="12"
							FontWeight="SemiBold"
							Margin="0,0,0,8" />

						<!-- 作者 -->
						<TextBlock
							Text="作者"
							FontSize="11"
							Foreground="{DynamicResource TextFillColorSecondaryBrush}"
							Margin="0,0,0,2" />
						<TextBox
							FontSize="12"
							Margin="0,0,0,6"
							Text="{Binding ZipAuthor.Value, UpdateSourceTrigger=PropertyChanged}" />

						<!-- タイトル -->
						<TextBlock
							Text="タイトル"
							FontSize="11"
							Foreground="{DynamicResource TextFillColorSecondaryBrush}"
							Margin="0,0,0,2" />
						<TextBox
							FontSize="12"
							Margin="0,0,0,6"
							Text="{Binding ZipTitle.Value, UpdateSourceTrigger=PropertyChanged}" />

						<!-- 出力zip -->
						<TextBlock
							Text="出力zip"
							FontSize="11"
							Foreground="{DynamicResource TextFillColorSecondaryBrush}"
							Margin="0,0,0,2" />
						<TextBox
							FontSize="12"
							Margin="0,0,0,6"
							Text="{Binding ZipOutputFileName.Value, UpdateSourceTrigger=PropertyChanged}" />

						<!-- 出力形式 -->
						<TextBlock
							Text="出力形式"
							FontSize="11"
							Foreground="{DynamicResource TextFillColorSecondaryBrush}"
							Margin="0,0,0,2" />
						<ComboBox
							FontSize="12"
							Margin="0,0,0,8"
							HorizontalAlignment="Left"
							MinWidth="200"
							ItemsSource="{Binding ZipOutputFormatItems}"
							SelectedIndex="{Binding ZipOutputFormatIndex.Value}" />

						<!-- 既存zip削除 -->
						<CheckBox
							Content="既存の製本済zipを削除する"
							FontSize="12"
							IsChecked="{Binding DeleteExistingZip.Value}"
							IsEnabled="{Binding ExistingZipExists.Value}"
							Margin="0,0,0,4" />

						<!-- iCloud削除（インデント） -->
						<CheckBox
							Content="iCloudからも削除する"
							FontSize="12"
							IsChecked="{Binding DeleteFromICloud.Value}"
							IsEnabled="{Binding DeleteExistingZip.Value}"
							Margin="16,0,0,0" />

					</StackPanel>
				</ui:Card>
			</controls:PageLayout.RightContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- FooterLeftContent: 戻るボタン -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.FooterLeftContent>
				<ui:Button
					Height="48"
					MinWidth="140"
					VerticalAlignment="Center"
					HorizontalAlignment="Left"
					Command="{Binding GoBackCommand}">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
						<ui:SymbolIcon Symbol="ChevronLeft16" FontSize="18" Margin="0,0,6,0" />
						<TextBlock Text="戻る" VerticalAlignment="Center" />
					</StackPanel>
				</ui:Button>
			</controls:PageLayout.FooterLeftContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- FooterRightContent: 製本開始ボタン -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.FooterRightContent>
				<ui:Button
					Height="48"
					MinWidth="140"
					VerticalAlignment="Center"
					HorizontalAlignment="Right"
					Appearance="Primary"
					Command="{Binding StartBindingCommand}">
					<TextBlock Text="製本開始" VerticalAlignment="Center" />
				</ui:Button>
			</controls:PageLayout.FooterRightContent>

		</controls:PageLayout>

	</local:BindingPageLayout>

</Page>
