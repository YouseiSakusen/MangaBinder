<Page x:Class="MangaBinder.Bindings.SeriesInspectionPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	  xmlns:local="clr-namespace:MangaBinder.Bindings"
	  xmlns:core="clr-namespace:MangaBinder.Bindings.Inspection;assembly=MangaBinder.Core"
	  xmlns:controls="clr-namespace:MangaBinder.Controls"
	  mc:Ignorable="d"
	  x:Name="ThisPage"
	  d:DesignHeight="800" d:DesignWidth="1200"
	  Title="製本前確認"
	  ui:NavigationView.HeaderContent="製本前確認"
	  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	  ScrollViewer.CanContentScroll="False">

	<Page.Resources>

		<!-- 巻カード ItemTemplate -->
		<DataTemplate x:Key="VolumeCardTemplate" DataType="{x:Type core:VolumeInspectionResult}">
			<ui:Card Margin="0,0,0,6" Padding="12,8">
				<!-- 3列 × 1行 Grid -->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<!-- Column0：左列 - サムネイル領域 -->
					<Border
						Grid.Column="0"
						Width="80"
						Height="112"
						CornerRadius="4"
						Margin="0,0,12,0"
						Background="{DynamicResource ControlFillColorDefaultBrush}">
						<Image
							Width="80"
							Height="112"
							Stretch="UniformToFill"
							RenderOptions.BitmapScalingMode="LowQuality" />
					</Border>

					<!-- Column1：中央列 - Inspection情報 -->
					<Grid
						Grid.Column="1"
						Margin="0,0,12,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<!-- Row0：巻数 / 巻フォルダ名 -->
						<TextBlock
							Grid.Row="0"
							Text="第01巻"
							FontSize="13"
							FontWeight="SemiBold"
							VerticalAlignment="Center"
							Margin="0,0,0,6" />

						<!-- Row1：画像数 -->
						<StackPanel
							Grid.Row="1"
							Orientation="Horizontal">
							<ui:SymbolIcon
								Symbol="ImageMultiple16"
								Filled="True"
								FontSize="16"
								VerticalAlignment="Center"
								Margin="0,0,6,0" />
							<TextBlock
								Text="総画像数：198"
								FontSize="11"
								VerticalAlignment="Center"
								Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
							<!-- 横長画像ありの場合は後続実装で
								 横長画像数 / 総画像数 表示へ切り替える -->
						</StackPanel>

						<!-- Row2：Error InfoBar -->
						<ui:InfoBar
							Grid.Row="2"
							Visibility="Collapsed"
							d:Visibility="Visible"
							Severity="Error"
							IsOpen="True"
							HorizontalAlignment="Stretch"
							Margin="0,6,0,0"
							Title="検査エラー"
							Message="検査中にエラーが発生しました。" />

						<!-- Row3：サブフォルダあり -->
						<StackPanel
							Grid.Row="3"
							Orientation="Horizontal"
							Visibility="Collapsed"
							d:Visibility="Visible">
							<ui:SymbolIcon
								Symbol="FolderMultiple16"
								Filled="True"
								FontSize="16"
								Margin="0,0,6,0"
								VerticalAlignment="Center"
								Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
							<TextBlock
								Text="サブフォルダあり"
								FontSize="11"
								VerticalAlignment="Center"
								Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
						</StackPanel>

						<!-- Row4：Warning -->
						<StackPanel
							Grid.Row="4"
							Orientation="Horizontal"
							Visibility="Collapsed"
							d:Visibility="Visible">
							<ui:SymbolIcon
								Symbol="Warning16"
								Filled="False"
								FontSize="16"
								Foreground="{DynamicResource SystemFillColorCautionBrush}"
								Margin="0,0,6,0"
								VerticalAlignment="Center" />
							<TextBlock
								Text="文字化けの可能性があります"
								FontSize="11"
								Foreground="{DynamicResource SystemFillColorCautionBrush}"
								VerticalAlignment="Center" />
						</StackPanel>
					</Grid>

					<!-- Column2：右列 - 見開き分割へ進むボタン -->
					<ui:Button
						Grid.Column="2"
						Style="{StaticResource CardNavigateButtonStyle}"
						VerticalAlignment="Center"
						ToolTip="見開き分割" />
				</Grid>
			</ui:Card>
		</DataTemplate>

	</Page.Resources>

	<!-- ════════════════════════════════════════════════════════════════ -->
	<!-- BindingPageLayout：製本工程共通レイアウト -->
	<!-- ════════════════════════════════════════════════════════════════ -->
	<local:BindingPageLayout
		Margin="16,4,16,16"
		SeriesTitle="{Binding SeriesTitle.Value}">

		<!-- PageLayout：3カラム + Eyecatch + Footer -->
		<controls:PageLayout
			LeftColumnWidth="250"
			LeftColumnMinWidth="250"
			MainColumnWidth="2*"
			RightColumnWidth="*"
			IsMainRightSplitterEnabled="True"
			EyecatchSymbol="ClipboardCheckmark24"
			EyecatchTitle="製本対象"
			EyecatchValueText="{Binding SelectedVolumeCountText.Value}">

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- LeftContent: 左パネル（作品情報） -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.LeftContent>
				<StackPanel
					Width="240"
					HorizontalAlignment="Center"
					VerticalAlignment="Top">

					<!-- 共通作品情報カード（MangaSeriesCard） -->
					<controls:MangaSeriesCard DataContext="{Binding MangaSeriesCard}" />
				</StackPanel>
			</controls:PageLayout.LeftContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- MainContent: 中央パネル（検査結果一覧） -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.MainContent>
				<ListView
					ItemsSource="{Binding InspectionResults}"
					ItemTemplate="{StaticResource VolumeCardTemplate}"
					Background="Transparent"
					BorderThickness="0"
					VirtualizingPanel.IsVirtualizing="True"
					VirtualizingPanel.VirtualizationMode="Recycling"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
					HorizontalContentAlignment="Stretch">
					<ListView.ItemContainerStyle>
						<Style TargetType="ListViewItem">
							<Setter Property="Padding" Value="0" />
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
							<Setter Property="Background" Value="Transparent" />
							<Setter Property="BorderThickness" Value="0" />
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="ListViewItem">
										<ContentPresenter />
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ListView.ItemContainerStyle>
				</ListView>
			</controls:PageLayout.MainContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- RightContent: 右パネル（製本後zipファイル設定） -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.RightContent>
				<ui:Card Margin="0,0,0,0" Padding="12,8" VerticalAlignment="Top">
					<StackPanel MaxWidth="720">

						<!-- カードタイトル -->
						<TextBlock
							Text="製本後zipファイル設定"
							FontSize="12"
							FontWeight="SemiBold"
							Margin="0,0,0,8" />

						<!-- 作者 -->
						<TextBlock
							Text="作者"
							FontSize="11"
							Foreground="{DynamicResource TextFillColorSecondaryBrush}"
							Margin="0,0,0,2" />
						<TextBox
							FontSize="12"
							Margin="0,0,0,6"
							Text="{Binding ZipAuthor.Value, UpdateSourceTrigger=PropertyChanged}" />

						<!-- タイトル -->
						<TextBlock
							Text="タイトル"
							FontSize="11"
							Foreground="{DynamicResource TextFillColorSecondaryBrush}"
							Margin="0,0,0,2" />
						<TextBox
							FontSize="12"
							Margin="0,0,0,6"
							Text="{Binding ZipTitle.Value, UpdateSourceTrigger=PropertyChanged}" />

						<!-- 出力zip -->
						<TextBlock
							Text="出力zip"
							FontSize="11"
							Foreground="{DynamicResource TextFillColorSecondaryBrush}"
							Margin="0,0,0,2" />
						<TextBox
							FontSize="12"
							Margin="0,0,0,6"
							Text="{Binding ZipOutputFileName.Value, UpdateSourceTrigger=PropertyChanged}" />

						<!-- 出力形式 -->
						<TextBlock
							Text="出力形式"
							FontSize="11"
							Foreground="{DynamicResource TextFillColorSecondaryBrush}"
							Margin="0,0,0,2" />
						<ComboBox
							FontSize="12"
							Margin="0,0,0,8"
							HorizontalAlignment="Left"
							MinWidth="200"
							ItemsSource="{Binding ZipOutputFormatItems}"
							SelectedIndex="{Binding ZipOutputFormatIndex.Value}" />

						<!-- 既存zip削除 -->
						<CheckBox
							Content="既存の製本済zipを削除する"
							FontSize="12"
							IsChecked="{Binding DeleteExistingZip.Value}"
							IsEnabled="{Binding ExistingZipExists.Value}"
							Margin="0,0,0,4" />

						<!-- iCloud削除（インデント） -->
						<CheckBox
							Content="iCloudからも削除する"
							FontSize="12"
							IsChecked="{Binding DeleteFromICloud.Value}"
							IsEnabled="{Binding DeleteExistingZip.Value}"
							Margin="16,0,0,0" />

					</StackPanel>
				</ui:Card>
			</controls:PageLayout.RightContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- FooterLeftContent: 戻るボタン -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.FooterLeftContent>
				<ui:Button
					Height="48"
					MinWidth="140"
					VerticalAlignment="Center"
					HorizontalAlignment="Left"
					Command="{Binding GoBackCommand}">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
						<ui:SymbolIcon Symbol="ChevronLeft16" FontSize="18" Margin="0,0,6,0" />
						<TextBlock Text="戻る" VerticalAlignment="Center" />
					</StackPanel>
				</ui:Button>
			</controls:PageLayout.FooterLeftContent>

			<!-- ─────────────────────────────────────────────────────────────────── -->
			<!-- FooterRightContent: 製本開始ボタン -->
			<!-- ─────────────────────────────────────────────────────────────────── -->
			<controls:PageLayout.FooterRightContent>
				<ui:Button
					Height="48"
					MinWidth="140"
					VerticalAlignment="Center"
					HorizontalAlignment="Right"
					Appearance="Primary"
					Command="{Binding StartBindingCommand}">
					<TextBlock Text="製本開始" VerticalAlignment="Center" />
				</ui:Button>
			</controls:PageLayout.FooterRightContent>

		</controls:PageLayout>

	</local:BindingPageLayout>

</Page>
