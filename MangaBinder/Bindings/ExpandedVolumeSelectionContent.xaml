<UserControl x:Class="MangaBinder.Bindings.ExpandedVolumeSelectionContent"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 Width="640"
			 Height="420">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TextBlock
			Grid.Row="0"
			Text="既存の展開済み画像をそのまま使用したい巻を選択してください。"
			TextWrapping="Wrap"
			Margin="0,0,0,12" />

		<ListView Grid.Row="1" />
	</Grid>
</UserControl>
