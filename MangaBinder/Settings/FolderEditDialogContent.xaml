<UserControl x:Class="MangaBinder.Settings.FolderEditDialogContent"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
			 xmlns:converters="clr-namespace:MangaBinder.Converters">

	<UserControl.Resources>
		<converters:FolderRoleToDefaultBindingConverter x:Key="FolderRoleToDefaultBindingConverter" />
	</UserControl.Resources>

	<StackPanel>

		<ui:InfoBar
			Margin="0,0,0,8"
			Title="フォルダの追加・変更について"
			Message="フォルダを追加又は、場所を変更した場合、設定後にフォルダのスキャンがバックグラウンドで実行されます。フォルダのスキャンには時間がかかる場合があります。"
			Severity="Informational"
			IsClosable="False"
			IsOpen="True" />

		<!-- フォルダ名 -->
		<ui:Card Style="{StaticResource SettingsItemCardStyle}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock
					Grid.Row="0"
					Margin="0,0,0,4"
					Style="{StaticResource SettingsItemTitleStyle}"
					Text="フォルダ名" />

				<ui:TextBox
					Grid.Row="1"
					FontSize="12"
					Text="{Binding TargetSourceFolder.DisplayName.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
			</Grid>
		</ui:Card>

		<!-- フォルダパス -->
		<ui:Card Style="{StaticResource SettingsItemCardStyle}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock
					Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
					Margin="0,0,0,4"
					Style="{StaticResource SettingsItemTitleStyle}"
					Text="フォルダパス" />

				<ui:TextBox
					Grid.Row="1" Grid.Column="0"
					Width="450"
					FontSize="12"
					HorizontalScrollBarVisibility="Auto"
					Text="{Binding TargetSourceFolder.FolderPath.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

				<ui:Button
					Grid.Row="1" Grid.Column="1"
					Margin="8,0,0,0"
					Icon="{ui:SymbolIcon FolderOpen20}"
					ToolTip="フォルダを参照"
					Command="{Binding BrowseTargetFolderCommand}" />
			</Grid>
		</ui:Card>

		<!-- 既定の製本先（製本済みフォルダのみ） -->
		<ui:Card
			Style="{StaticResource SettingsItemCardStyle}"
			Visibility="{Binding TargetSourceFolder.Role.Value, Mode=OneTime, Converter={StaticResource FolderRoleToDefaultBindingConverter}, ConverterParameter=Visibility}">
			<Grid Height="44">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock
					Grid.Column="0"
					VerticalAlignment="Center"
					Style="{StaticResource SettingsItemTitleStyle}"
					Text="既定の製本先" />

				<ui:ToggleSwitch
					Grid.Column="1"
					VerticalAlignment="Center"
					IsEnabled="{Binding CanChangeDefaultBinding, Mode=OneTime}"
					IsChecked="{Binding TargetSourceFolder.Role.Value, Mode=TwoWay, Converter={StaticResource FolderRoleToDefaultBindingConverter}}" />
			</Grid>
		</ui:Card>

	</StackPanel>
</UserControl>
