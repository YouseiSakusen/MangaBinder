<Page x:Class="MangaBinder.Settings.SettingsPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	  xmlns:local="clr-namespace:MangaBinder.Settings"
	  xmlns:shared="clr-namespace:MangaBinder.Settings;assembly=MangaBinder.Shared"
	  xmlns:controls="clr-namespace:MangaBinder.Controls"
	  mc:Ignorable="d"
	  d:DesignHeight="700" d:DesignWidth="900"
	  Title="SettingsPage"
	  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	  ScrollViewer.CanContentScroll="False">

	<Page.Resources>

		<!-- フォルダ一覧の行テンプレート（素材・製本済み共通） -->
		<DataTemplate x:Key="SourceFolderRowTemplate">
			<Grid Margin="0,4">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<ui:SymbolIcon
					Grid.Column="0"
					Symbol="Folder24"
					FontSize="24"
					VerticalAlignment="Center"
					Margin="0,0,12,0" />

				<Grid Grid.Column="1" VerticalAlignment="Center">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Grid Grid.Row="0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<TextBlock
							Grid.Column="0"
							Text="{Binding DisplayName.Value}"
							Style="{StaticResource BodyStrongTextBlockStyle}"
							TextTrimming="CharacterEllipsis" />

						<Border
							x:Name="DefaultBadge"
							Grid.Column="1"
							Visibility="Collapsed"
							Margin="8,0,0,0"
							Padding="6,0"
							CornerRadius="4"
							VerticalAlignment="Center"
							Background="{DynamicResource ControlFillColorSecondaryBrush}">
							<TextBlock
								Text="既定"
								FontSize="11"
								Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
						</Border>
					</Grid>

					<TextBlock
						Grid.Row="1"
						Text="{Binding FolderPath.Value}"
						FontSize="11"
						Foreground="{DynamicResource TextFillColorSecondaryBrush}"
						TextTrimming="CharacterEllipsis"
						ToolTip="{Binding FolderPath.Value}" />
				</Grid>

				<ui:Button
					Grid.Column="2"
					Icon="{ui:SymbolIcon Edit20}"
					Appearance="Secondary"
					VerticalAlignment="Center"
					ToolTip="フォルダ設定を編集"
					IsEnabled="False" />
			</Grid>
			<DataTemplate.Triggers>
				<DataTrigger Binding="{Binding Role.Value}" Value="{x:Static shared:FolderRole.DefaultBinding}">
					<Setter TargetName="DefaultBadge" Property="Visibility" Value="Visible" />
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>

		<!-- フォルダ一覧ListViewのStyle（約3件で内部スクロール、横スクロール禁止） -->
		<Style x:Key="SourceFolderListViewStyle" TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
			<Setter Property="MaxHeight" Value="168" />
			<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
			<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="ItemTemplate" Value="{StaticResource SourceFolderRowTemplate}" />
		</Style>

	</Page.Resources>

	<controls:PageLayout
		Margin="16,4,16,16"
		LeftColumnWidth="0"
		LeftColumnMinWidth="0"
		MainColumnWidth="*"
		RightColumnWidth="0"
		RightColumnMinWidth="0"
		EyecatchSymbol="Wrench24"
		EyecatchTitle="設定"
		EyecatchValueText="">

		<controls:PageLayout.MainContent>
			<ScrollViewer
				VerticalScrollBarVisibility="Auto"
				HorizontalScrollBarVisibility="Disabled">

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!-- 各種フォルダ -->
					<ui:Card Grid.Row="0" Style="{StaticResource SettingsGroupCardStyle}">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<TextBlock
								Grid.Row="0"
								Text="各種フォルダ"
								Style="{StaticResource SettingsGroupTitleStyle}" />

							<!-- 素材フォルダ -->
							<ui:Card Grid.Row="1" Style="{StaticResource SettingsItemCardStyle}">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Row="0" Grid.Column="0"
										VerticalAlignment="Center"
										Style="{StaticResource SettingsItemTitleStyle}"
										Text="素材フォルダ" />
									<ui:Button
										Grid.Row="0" Grid.Column="1"
										Content="追加"
										Icon="{ui:SymbolIcon Add20}"
										IsEnabled="False" />

									<ListView
										Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
										Margin="0,8,0,0"
										Style="{StaticResource SourceFolderListViewStyle}"
										ItemsSource="{Binding MaterialFolders}" />
								</Grid>
							</ui:Card>

							<!-- 製本済みフォルダ -->
							<ui:Card Grid.Row="2" Style="{StaticResource SettingsItemCardStyle}">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Row="0" Grid.Column="0"
										VerticalAlignment="Center"
										Style="{StaticResource SettingsItemTitleStyle}"
										Text="製本済みフォルダ" />
									<ui:Button
										Grid.Row="0" Grid.Column="1"
										Content="追加"
										Icon="{ui:SymbolIcon Add20}"
										IsEnabled="False" />

									<ListView
										Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
										Margin="0,8,0,0"
										Style="{StaticResource SourceFolderListViewStyle}"
										ItemsSource="{Binding BindingFolders}" />
								</Grid>
							</ui:Card>

							<!-- 展開先フォルダ -->
							<ui:Card Grid.Row="3" Style="{StaticResource SettingsItemCardStyle}">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
										Style="{StaticResource SettingsItemTitleStyle}"
										Text="展開先フォルダ" />

									<ui:TextBox
										Grid.Row="1" Grid.Column="0"
										Margin="0,8,8,0"
										VerticalAlignment="Center"
										Text="{Binding WorkFolderPath.Value, UpdateSourceTrigger=PropertyChanged}" />
									<ui:Button
										Grid.Row="1" Grid.Column="1"
										Margin="0,8,0,0"
										Content="参照"
										Icon="{ui:SymbolIcon FolderOpen24}"
										Command="{Binding BrowseWorkFolderCommand}" />
								</Grid>
							</ui:Card>
						</Grid>
					</ui:Card>
				</Grid>
			</ScrollViewer>
		</controls:PageLayout.MainContent>
	</controls:PageLayout>
</Page>
