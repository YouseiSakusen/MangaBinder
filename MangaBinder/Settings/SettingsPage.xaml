<Page x:Class="MangaBinder.Settings.SettingsPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	  xmlns:local="clr-namespace:MangaBinder.Settings"
	  xmlns:shared="clr-namespace:MangaBinder.Settings;assembly=MangaBinder.Shared"
	  xmlns:controls="clr-namespace:MangaBinder.Controls"
	  xmlns:behaviors="clr-namespace:MangaBinder.Behaviors"
	  xmlns:converters="clr-namespace:MangaBinder.Converters"
	  mc:Ignorable="d"
	  d:DesignHeight="700" d:DesignWidth="900"
	  Title="SettingsPage"
	  behaviors:SettingsPageInitializeBehavior.IsEnabled="True"
	  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	  ScrollViewer.CanContentScroll="False">

	<Page.Resources>

		<converters:BindingZipFileNameSampleConverter x:Key="BindingZipFileNameSampleConverter" />
		<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

		<!-- ファイル名構成の入力用TextBox Style -->
		<Style x:Key="FileNameTokenTextBoxStyle" TargetType="{x:Type ui:TextBox}" BasedOn="{StaticResource {x:Type ui:TextBox}}">
			<Setter Property="MinWidth" Value="48" />
			<Setter Property="Margin" Value="2,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextAlignment" Value="Center" />
		</Style>

		<!-- ファイル名構成の固定表示TextBlock Style -->
		<Style x:Key="FileNameFixedTextStyle" TargetType="{x:Type TextBlock}">
			<Setter Property="Margin" Value="2,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
		</Style>

		<!-- フォルダ一覧の行テンプレート（素材・製本済み共通） -->
		<DataTemplate x:Key="SourceFolderRowTemplate">
			<ui:Card Style="{StaticResource SettingsItemCardStyle}" Margin="0" HorizontalAlignment="Stretch">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<ui:SymbolIcon
					Grid.Column="0"
					Symbol="Folder16"
					FontSize="16"
					VerticalAlignment="Center"
					Margin="0,0,8,0" />

				<Grid Grid.Column="1" VerticalAlignment="Center">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Grid Grid.Row="0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<TextBlock
							Grid.Column="0"
							Text="{Binding DisplayName.Value}"
							Style="{StaticResource BodyStrongTextBlockStyle}"
							TextTrimming="CharacterEllipsis" />

						<Border
							x:Name="DefaultBadge"
							Grid.Column="1"
							Visibility="Collapsed"
							Margin="8,0,0,0"
							Padding="6,0"
							CornerRadius="4"
							VerticalAlignment="Center"
							Background="{DynamicResource ControlFillColorSecondaryBrush}">
							<TextBlock
								Text="既定"
								FontSize="11"
								Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
						</Border>
					</Grid>

					<TextBlock
						Grid.Row="1"
						Text="{Binding FolderPath.Value}"
						FontSize="11"
						Foreground="{DynamicResource TextFillColorSecondaryBrush}"
						TextTrimming="CharacterEllipsis"
						ToolTip="{Binding FolderPath.Value}" />
				</Grid>

				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
					<ui:Button
						Icon="{ui:SymbolIcon Edit20}"
						Appearance="Secondary"
						VerticalAlignment="Center"
						ToolTip="フォルダ設定を編集"
						Command="{Binding DataContext.EditFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
						CommandParameter="{Binding}" />
					<ui:Button
						Margin="4,0,0,0"
						Icon="{ui:SymbolIcon Dismiss20}"
						Appearance="Secondary"
						VerticalAlignment="Center"
						ToolTip="フォルダの登録を削除"
						Command="{Binding DataContext.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
						CommandParameter="{Binding}" />
				</StackPanel>
			</Grid>
			</ui:Card>
			<DataTemplate.Triggers>
				<DataTrigger Binding="{Binding Role.Value}" Value="{x:Static shared:FolderRole.DefaultBinding}">
					<Setter TargetName="DefaultBadge" Property="Visibility" Value="Visible" />
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>

		<!-- フォルダ一覧ListViewのStyle（約3件で内部スクロール、横スクロール禁止） -->
		<Style x:Key="SourceFolderListViewStyle" TargetType="ListView">
			<Setter Property="MaxHeight" Value="168" />
			<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
			<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="ItemTemplate" Value="{StaticResource SourceFolderRowTemplate}" />
			<Setter Property="ItemContainerStyle">
				<Setter.Value>
					<Style TargetType="ListViewItem">
						<Setter Property="BorderThickness" Value="0" />
						<Setter Property="Background" Value="Transparent" />
						<Setter Property="Padding" Value="0" />
						<Setter Property="Margin" Value="0,0,0,4" />
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					</Style>
				</Setter.Value>
			</Setter>
		</Style>

	</Page.Resources>

	<controls:PageLayout
		Margin="16,4,16,16"
		EyecatchSymbol="Wrench24"
		EyecatchTitle="設定"
		EyecatchValueText="">

		<controls:PageLayout.MainContent>
			<ScrollViewer
				VerticalScrollBarVisibility="Auto"
				HorizontalScrollBarVisibility="Disabled">

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!-- 初回設定時の自動保存案内 -->
					<ui:InfoBar
						Grid.Row="0"
						Margin="0,0,0,8"
						Title="設定は自動保存されます"
						Message="設定画面から別の画面へ移動すると、変更内容が自動的に保存されます。"
						Severity="Informational"
						IsClosable="True"
						IsOpen="{Binding ShowInitialSetupInfoBar.Value, Mode=OneWay}" />

					<!-- 各種フォルダ -->
					<ui:Card Grid.Row="1" Style="{StaticResource SettingsGroupCardStyle}">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<TextBlock
								Grid.Row="0"
								Text="各種フォルダ"
								Style="{StaticResource SettingsGroupTitleStyle}" />

							<TextBlock
								Grid.Row="1"
								Margin="0,0,0,8"
								Text="アプリで使用するフォルダを設定します。"
								Style="{StaticResource SettingsGroupDescriptionStyle}" />

							<!-- 素材フォルダ -->
							<ui:Card Grid.Row="2" Style="{StaticResource SettingsItemCardStyle}">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Row="0" Grid.Column="0"
										VerticalAlignment="Center"
										Style="{StaticResource SettingsItemTitleStyle}"
										Text="素材フォルダ" />
									<ui:Button
										Grid.Row="0" Grid.Column="1"
										Content="追加"
										Icon="{ui:SymbolIcon Add20}"
										Command="{Binding AddFolderCommand}"
										CommandParameter="{x:Static shared:FolderRole.Material}" />

									<TextBlock
										Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
										Text="漫画の素材を置いているフォルダを設定します。"
										Style="{StaticResource SettingsItemDescriptionStyle}" />

									<ListView
										Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
										Margin="0,8,0,0"
										Style="{StaticResource SourceFolderListViewStyle}"
										x:Name="MaterialFoldersListView"
										Visibility="{Binding HasMaterialFolder.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
										ItemsSource="{Binding MaterialFolders}" />

									<StackPanel
										Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
										Margin="0,12,0,4"
										HorizontalAlignment="Center"
										Visibility="{Binding HasMaterialFolder.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
										<ui:SymbolIcon
											Symbol="FolderAdd24"
											FontSize="32"
											Foreground="{DynamicResource BindingAccentBrush}" />
										<TextBlock
											Margin="0,8,0,4"
											HorizontalAlignment="Center"
											FontSize="15"
											FontWeight="SemiBold"
											Text="素材フォルダが登録されていません" />
										<TextBlock
											HorizontalAlignment="Center"
											FontSize="13"
											Opacity="0.7"
											TextAlignment="Center"
											TextWrapping="Wrap">
											<Run Text="作品を登録するには素材フォルダが必要です。" />
											<LineBreak />
											<Run Text="右上の「追加」からフォルダを登録してください。" />
										</TextBlock>
									</StackPanel>
								</Grid>
							</ui:Card>

							<!-- 製本済みフォルダ -->
							<ui:Card Grid.Row="3" Style="{StaticResource SettingsItemCardStyle}">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Row="0" Grid.Column="0"
										VerticalAlignment="Center"
										Style="{StaticResource SettingsItemTitleStyle}"
										Text="製本済みフォルダ" />
									<ui:Button
										Grid.Row="0" Grid.Column="1"
												Content="追加"
												Icon="{ui:SymbolIcon Add20}"
												Command="{Binding AddFolderCommand}"
												CommandParameter="{x:Static shared:FolderRole.Binding}" />

											<TextBlock
												Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
												Text="製本済zipを置いているフォルダを設定します。"
										Style="{StaticResource SettingsItemDescriptionStyle}" />

									<ListView
										Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
										Margin="0,8,0,0"
										Style="{StaticResource SourceFolderListViewStyle}"
										x:Name="BindingFoldersListView"
										Visibility="{Binding HasBindingFolder.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
										ItemsSource="{Binding BindingFolders}" />

									<StackPanel
										Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
										Margin="0,12,0,4"
										HorizontalAlignment="Center"
										Visibility="{Binding HasBindingFolder.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
										<ui:SymbolIcon
											Symbol="FolderAdd24"
											FontSize="32"
											Foreground="{DynamicResource BindingAccentBrush}" />
										<TextBlock
											Margin="0,8,0,4"
											HorizontalAlignment="Center"
											FontSize="15"
											FontWeight="SemiBold"
											Text="製本済みフォルダが登録されていません" />
										<TextBlock
											HorizontalAlignment="Center"
											FontSize="13"
											Opacity="0.7"
											TextAlignment="Center"
											TextWrapping="Wrap">
											<Run Text="製本するには製本済みフォルダが必要です。" />
											<LineBreak />
											<Run Text="右上の「追加」からフォルダを登録してください。" />
										</TextBlock>
									</StackPanel>
								</Grid>
							</ui:Card>

							<!-- 展開先フォルダ -->
							<ui:Card Grid.Row="4" Style="{StaticResource SettingsItemCardStyle}">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
										Style="{StaticResource SettingsItemTitleStyle}"
										Text="展開先フォルダ" />
									<TextBlock
										Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
										Text="製本時に素材の画像を展開するフォルダを設定します。"
										Style="{StaticResource SettingsItemDescriptionStyle}" />
									<ui:TextBox
										Grid.Row="2" Grid.Column="0"
										Margin="0,8,8,0"
										VerticalAlignment="Center"
										PlaceholderText="製本する画像の展開先フォルダを指定してください。"
										Text="{Binding WorkFolderPath.Value, UpdateSourceTrigger=PropertyChanged}" />
									<ui:Button
										Grid.Row="2" Grid.Column="1"
										Margin="0,8,0,0"
										Content="参照"
										Icon="{ui:SymbolIcon FolderOpen24}"
										Command="{Binding BrowseWorkFolderCommand}" />
								</Grid>
							</ui:Card>
						</Grid>
					</ui:Card>

					<!-- 製本後ファイル名 -->
					<ui:Card
						Grid.Row="2"
						Style="{StaticResource SettingsGroupCardStyle}"
						Visibility="{Binding HasBindingFolder.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
						<StackPanel>
							<TextBlock
								Text="製本後ファイル名"
								Style="{StaticResource SettingsGroupTitleStyle}" />
							<TextBlock
								Margin="0,0,0,8"
								Text="製本して作成するファイル名の命名規則を設定します。"
								Style="{StaticResource SettingsGroupDescriptionStyle}" />

							<!-- 範囲製本 -->
							<ui:Card Style="{StaticResource SettingsItemCardStyle}">
								<StackPanel>
									<TextBlock
										Style="{StaticResource SettingsItemTitleStyle}"
										Text="範囲製本" />
									<WrapPanel Margin="0,8,0,0">
										<ui:TextBox
											Style="{StaticResource FileNameTokenTextBoxStyle}"
											Text="{Binding BindingZipAuthorLeftBracket.Value, UpdateSourceTrigger=PropertyChanged}" />
										<TextBlock Style="{StaticResource FileNameFixedTextStyle}" Text="作者名" />
										<ui:TextBox
											Style="{StaticResource FileNameTokenTextBoxStyle}"
											Text="{Binding BindingZipAuthorRightBracket.Value, UpdateSourceTrigger=PropertyChanged}" />
										<ui:TextBox
											Style="{StaticResource FileNameTokenTextBoxStyle}"
											Text="{Binding BindingZipNameSeparator.Value, UpdateSourceTrigger=PropertyChanged}" />
										<TextBlock Style="{StaticResource FileNameFixedTextStyle}" Text="タイトル" />
										<TextBlock
											Style="{StaticResource FileNameFixedTextStyle}"
											Text="{Binding BindingZipNameSeparator.Value, Mode=OneWay}" />
										<ui:TextBox
											Style="{StaticResource FileNameTokenTextBoxStyle}"
											Text="{Binding BindingZipNormalVolumePrefix.Value, UpdateSourceTrigger=PropertyChanged}" />
										<TextBlock Style="{StaticResource FileNameFixedTextStyle}" Text="01" />
										<ui:TextBox
											Style="{StaticResource FileNameTokenTextBoxStyle}"
											Text="{Binding BindingZipNormalVolumeSeparator.Value, UpdateSourceTrigger=PropertyChanged}" />
										<TextBlock Style="{StaticResource FileNameFixedTextStyle}" Text="20" />
										<ui:TextBox
											Style="{StaticResource FileNameTokenTextBoxStyle}"
											Text="{Binding BindingZipNormalVolumeSuffix.Value, UpdateSourceTrigger=PropertyChanged}" />
									</WrapPanel>
								</StackPanel>
							</ui:Card>

							<!-- 全巻製本 -->
							<ui:Card Style="{StaticResource SettingsItemCardStyle}">
								<StackPanel>
									<TextBlock
										Style="{StaticResource SettingsItemTitleStyle}"
										Text="全巻製本" />
									<WrapPanel Margin="0,8,0,0">
										<TextBlock
											Style="{StaticResource FileNameFixedTextStyle}"
											Text="{Binding BindingZipAuthorLeftBracket.Value, Mode=OneWay}" />
										<TextBlock Style="{StaticResource FileNameFixedTextStyle}" Text="作者名" />
										<TextBlock
											Style="{StaticResource FileNameFixedTextStyle}"
											Text="{Binding BindingZipAuthorRightBracket.Value, Mode=OneWay}" />
										<TextBlock
											Style="{StaticResource FileNameFixedTextStyle}"
											Text="{Binding BindingZipNameSeparator.Value, Mode=OneWay}" />
										<TextBlock Style="{StaticResource FileNameFixedTextStyle}" Text="タイトル" />
										<TextBlock
											Style="{StaticResource FileNameFixedTextStyle}"
											Text="{Binding BindingZipNameSeparator.Value, Mode=OneWay}" />

										<!-- 完結文字が巻数の前 -->
										<StackPanel Orientation="Horizontal">
											<StackPanel.Style>
												<Style TargetType="StackPanel">
													<Setter Property="Visibility" Value="Collapsed" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding BindingZipCompleteMarkerPosition.Value}" Value="{x:Static shared:CompleteMarkerPosition.BeforeVolume}">
															<Setter Property="Visibility" Value="Visible" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</StackPanel.Style>
											<ui:TextBox
												Style="{StaticResource FileNameTokenTextBoxStyle}"
												Text="{Binding BindingZipCompleteVolumePrefix.Value, UpdateSourceTrigger=PropertyChanged}" />
											<TextBlock Style="{StaticResource FileNameFixedTextStyle}" Text="38" />
											<ui:TextBox
												Style="{StaticResource FileNameTokenTextBoxStyle}"
												Text="{Binding BindingZipCompleteVolumeSuffix.Value, UpdateSourceTrigger=PropertyChanged}" />
										</StackPanel>

										<!-- 完結文字が巻数の後 -->
										<StackPanel Orientation="Horizontal">
											<StackPanel.Style>
												<Style TargetType="StackPanel">
													<Setter Property="Visibility" Value="Collapsed" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding BindingZipCompleteMarkerPosition.Value}" Value="{x:Static shared:CompleteMarkerPosition.AfterVolume}">
															<Setter Property="Visibility" Value="Visible" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</StackPanel.Style>
											<TextBlock Style="{StaticResource FileNameFixedTextStyle}" Text="38" />
											<ui:TextBox
												Style="{StaticResource FileNameTokenTextBoxStyle}"
												Text="{Binding BindingZipCompleteVolumeSuffix.Value, UpdateSourceTrigger=PropertyChanged}" />
											<ui:TextBox
												Style="{StaticResource FileNameTokenTextBoxStyle}"
												Text="{Binding BindingZipCompleteVolumePrefix.Value, UpdateSourceTrigger=PropertyChanged}" />
										</StackPanel>
									</WrapPanel>
								</StackPanel>
							</ui:Card>

							<!-- 完結文字の位置 -->
							<ui:Card Style="{StaticResource SettingsItemCardStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<TextBlock
										VerticalAlignment="Center"
										Style="{StaticResource SettingsItemTitleStyle}"
										Text="完結を表す文字の位置" />
									<ComboBox
										Grid.Column="1"
										Width="180"
										SelectedValuePath="Tag"
										SelectedValue="{Binding BindingZipCompleteMarkerPosition.Value, Mode=TwoWay}">
										<ComboBoxItem Tag="{x:Static shared:CompleteMarkerPosition.BeforeVolume}">巻数の前に追加</ComboBoxItem>
										<ComboBoxItem Tag="{x:Static shared:CompleteMarkerPosition.AfterVolume}">巻数の後に追加</ComboBoxItem>
									</ComboBox>
								</Grid>
							</ui:Card>

							<!-- 開始巻～完結表記 -->
							<ui:Card Style="{StaticResource SettingsItemCardStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<StackPanel VerticalAlignment="Center">
										<TextBlock
											Style="{StaticResource SettingsItemTitleStyle}"
											Text="開始巻～完結表記" />
										<TextBlock
											Style="{StaticResource SettingsItemDescriptionStyle}"
											Text="範囲製本の最終巻が完結巻の場合に、完結を表す文字を追加します。" />
									</StackPanel>
									<ComboBox
										Grid.Column="1"
										Width="180"
										SelectedValuePath="Tag"
										SelectedValue="{Binding BindingZipUsePartialCompleteMarker.Value, Mode=TwoWay}">
										<ComboBoxItem Tag="True">使用する</ComboBoxItem>
										<ComboBoxItem Tag="False">使用しない</ComboBoxItem>
									</ComboBox>
								</Grid>
							</ui:Card>

							<!-- ゼロ埋め -->
							<ui:Card Style="{StaticResource SettingsItemCardStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<TextBlock
										VerticalAlignment="Center"
										Style="{StaticResource SettingsItemTitleStyle}"
										Text="完結巻数をゼロ埋めする" />
									<ui:ToggleSwitch
										Grid.Column="1"
										IsChecked="{Binding BindingZipCompleteVolumeZeroPadding.Value, Mode=TwoWay}" />
								</Grid>
							</ui:Card>

							<!-- サンプル -->
							<ui:Card Style="{StaticResource SettingsItemCardStyle}">
								<StackPanel>
									<TextBlock
										Style="{StaticResource SettingsItemTitleStyle}"
										Text="ファイル名サンプル" />
									<ItemsControl Margin="0,8,0,0">
										<ItemsControl.Resources>
											<Style TargetType="TextBlock">
												<Setter Property="Margin" Value="0,2" />
											</Style>
										</ItemsControl.Resources>
										<TextBlock>
											<TextBlock.Text>
												<MultiBinding Converter="{StaticResource BindingZipFileNameSampleConverter}" ConverterParameter="Range">
													<Binding Path="BindingZipAuthorLeftBracket.Value" />
													<Binding Path="BindingZipAuthorRightBracket.Value" />
													<Binding Path="BindingZipNameSeparator.Value" />
													<Binding Path="BindingZipNormalVolumePrefix.Value" />
													<Binding Path="BindingZipNormalVolumeSeparator.Value" />
													<Binding Path="BindingZipNormalVolumeSuffix.Value" />
													<Binding Path="BindingZipCompleteVolumePrefix.Value" />
													<Binding Path="BindingZipCompleteVolumeSuffix.Value" />
													<Binding Path="BindingZipCompleteMarkerPosition.Value" />
													<Binding Path="BindingZipUsePartialCompleteMarker.Value" />
													<Binding Path="BindingZipCompleteVolumeZeroPadding.Value" />
													<Binding Path="BindingDefaultArchiveExtension.Value" />
												</MultiBinding>
											</TextBlock.Text>
										</TextBlock>
										<TextBlock>
											<TextBlock.Text>
												<MultiBinding Converter="{StaticResource BindingZipFileNameSampleConverter}" ConverterParameter="Complete">
													<Binding Path="BindingZipAuthorLeftBracket.Value" />
													<Binding Path="BindingZipAuthorRightBracket.Value" />
													<Binding Path="BindingZipNameSeparator.Value" />
													<Binding Path="BindingZipNormalVolumePrefix.Value" />
													<Binding Path="BindingZipNormalVolumeSeparator.Value" />
													<Binding Path="BindingZipNormalVolumeSuffix.Value" />
													<Binding Path="BindingZipCompleteVolumePrefix.Value" />
													<Binding Path="BindingZipCompleteVolumeSuffix.Value" />
													<Binding Path="BindingZipCompleteMarkerPosition.Value" />
													<Binding Path="BindingZipUsePartialCompleteMarker.Value" />
													<Binding Path="BindingZipCompleteVolumeZeroPadding.Value" />
													<Binding Path="BindingDefaultArchiveExtension.Value" />
