<Application
  x:Class="MangaBinder.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  ShutdownMode="OnMainWindowClose"
  DispatcherUnhandledException="OnDispatcherUnhandledException"
  Exit="OnExit"
  Startup="OnStartup"
>
  <Application.Resources>
	<ResourceDictionary>
	  <ResourceDictionary.MergedDictionaries>
		<ui:ThemesDictionary Theme="Light" />
		<ui:ControlsDictionary />
	  </ResourceDictionary.MergedDictionaries>
	  <!-- MangaBinder アプリカラー：製本・本・クラフト感に合う落ち着いた茶系 -->
	  <SolidColorBrush x:Key="BindingAccentBrush" Color="#7B5235" />
	  <!-- 巻情報バッジ：連載中の場合の背景色（青系） -->
	  <SolidColorBrush x:Key="InProgressBrush" Color="#3B82C4" />
	  <!-- 巻情報バッジ：完結済み・全巻所持済みの場合の背景色（金系） -->
	  <SolidColorBrush x:Key="OwnedCompletedBrush" Color="#C89B3C" />
	  <!-- 巻情報バッジ：完結済み・全巻未所持の場合の背景色（グレー） -->
	  <SolidColorBrush x:Key="NotOwnedCompletedBrush" Color="#909090" Opacity="0.6" />
	  <!-- 巻情報バッジ：未完の場合の背景色（将来使用） -->
	  <SolidColorBrush x:Key="IncompleteBrush" Color="#5F6B7A" Opacity="0.65" />
	  <!-- タグ表示用の共通色（薄いオレンジ～黄色） -->
	  <SolidColorBrush x:Key="TagBrush" Color="#FFD983" />

	  <!-- アプリケーション共通ナビゲーションボタンStyle -->
	  <Style
		  x:Key="CardNavigateButtonStyle"
		  TargetType="{x:Type ui:Button}">
		  <Setter Property="Appearance" Value="Transparent" />
		  <Setter Property="Width" Value="28" />
		  <Setter Property="Height" Value="28" />
		  <Setter Property="Padding" Value="0" />
		  <Setter Property="HorizontalAlignment" Value="Center" />
		  <Setter Property="VerticalAlignment" Value="Center" />
		  <Setter Property="Background" Value="Transparent" />
		  <Setter Property="BorderBrush" Value="Transparent" />
		  <Setter Property="MouseOverBackground"
				  Value="{DynamicResource ControlFillColorSecondaryBrush}" />
		  <Setter Property="MouseOverBorderBrush" Value="Transparent" />
		  <Setter Property="Content" Value="▶" />
		  <Setter Property="ContentTemplate">
			  <Setter.Value>
				  <DataTemplate>
					  <TextBlock
						  Text="{Binding}"
						  FontSize="12"
						  Opacity="0.6"
						  HorizontalAlignment="Center"
						  VerticalAlignment="Center"
						  Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
				  </DataTemplate>
			  </Setter.Value>
		  </Setter>
	  </Style>
	</ResourceDictionary>
  </Application.Resources>
</Application>
