<Application
  x:Class="MangaBinder.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  ShutdownMode="OnMainWindowClose"
  DispatcherUnhandledException="OnDispatcherUnhandledException"
  Exit="OnExit"
  Startup="OnStartup"
>
  <Application.Resources>
	<ResourceDictionary>
	  <ResourceDictionary.MergedDictionaries>
		<ui:ThemesDictionary Theme="Light" />
		<ui:ControlsDictionary />
	  </ResourceDictionary.MergedDictionaries>
	  <!-- MangaBinder アプリカラー：製本・本・クラフト感に合う落ち着いた茶系 -->
	  <SolidColorBrush x:Key="BindingAccentBrush" Color="#7B5235" />
	  <!-- 巻情報バッジ：連載中の場合の背景色（青系） -->
	  <SolidColorBrush x:Key="InProgressBrush" Color="#3B82C4" />
	  <!-- 巻情報バッジ：完結済み・全巻所持済みの場合の背景色（金系） -->
	  <SolidColorBrush x:Key="OwnedCompletedBrush" Color="#C89B3C" />
	  <!-- 巻情報バッジ：完結済み・全巻未所持の場合の背景色（グレー） -->
	  <SolidColorBrush x:Key="NotOwnedCompletedBrush" Color="#909090" Opacity="0.6" />
	  <!-- 巻情報バッジ：未完の場合の背景色（将来使用） -->
	  <SolidColorBrush x:Key="IncompleteBrush" Color="#5F6B7A" Opacity="0.65" />
	  <!-- タグ表示用の共通色（薄いオレンジ～黄色） -->
	  <SolidColorBrush x:Key="TagBrush" Color="#FFD983" />

	  <!-- 素材種類アイコン用共通ブラシ -->
		  <!-- 実フォルダルート：主役、濃い黄土色 -->
		  <SolidColorBrush x:Key="MaterialRootIconBrush" Color="#C58A00" />
		  <!-- 実フォルダ：主役、濃い黄土色 -->
		  <SolidColorBrush x:Key="MaterialFolderIconBrush" Color="#B8860B" />
		  <!-- 圧縮ファイル本体：コンテナ、控えめな青灰色 -->
		  <SolidColorBrush x:Key="MaterialArchiveIconBrush" Color="#6E87A8" />
		  <!-- EPUB：主役、緑系 -->
		  <SolidColorBrush x:Key="MaterialEpubIconBrush" Color="#2E9F55" />

	  <!-- アプリケーション共通ナビゲーションボタンStyle -->
	  <Style
		  x:Key="CardNavigateButtonStyle"
		  TargetType="{x:Type ui:Button}">
		  <Setter Property="Appearance" Value="Transparent" />
		  <Setter Property="Width" Value="28" />
		  <Setter Property="Height" Value="28" />
		  <Setter Property="Padding" Value="0" />
		  <Setter Property="HorizontalAlignment" Value="Center" />
		  <Setter Property="VerticalAlignment" Value="Center" />
		  <Setter Property="Background" Value="Transparent" />
		  <Setter Property="BorderBrush" Value="Transparent" />
		  <Setter Property="MouseOverBackground"
				  Value="{DynamicResource ControlFillColorSecondaryBrush}" />
		  <Setter Property="MouseOverBorderBrush" Value="Transparent" />
		  <Setter Property="Content" Value="▶" />
		  <Setter Property="ContentTemplate">
			  <Setter.Value>
				  <DataTemplate>
					  <TextBlock
						  Text="{Binding}"
						  FontSize="12"
						  Opacity="0.6"
						  HorizontalAlignment="Center"
						  VerticalAlignment="Center"
						  Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
				  </DataTemplate>
			  </Setter.Value>
		  </Setter>
	  </Style>

	  <!-- フッターボタン共通Style -->
	  <Style
		x:Key="FooterButtonStyle"
		TargetType="{x:Type ui:Button}"
		BasedOn="{StaticResource DefaultUiButtonStyle}">
		<Setter Property="Height" Value="48" />
		<Setter Property="MinWidth" Value="140" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	  <!-- フッター Primary ボタンStyle -->
	  <Style
		  x:Key="FooterPrimaryButtonStyle"
		  TargetType="{x:Type ui:Button}"
		  BasedOn="{StaticResource FooterButtonStyle}">
		  <Setter Property="Appearance" Value="Primary" />
	  </Style>

	  <!-- 画面上部アクションボタン共通Style -->
	  <Style
		  x:Key="TopActionButtonStyle"
		  TargetType="{x:Type ui:Button}"
		  BasedOn="{StaticResource DefaultUiButtonStyle}">
		  <Setter Property="Width" Value="200" />
		  <Setter Property="Height" Value="56" />
		  <Setter Property="Padding" Value="12,6" />
		  <Setter Property="VerticalAlignment" Value="Center" />
		  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
	  </Style>

		<!-- 設定グループCard（GroupBox相当の外側Card）Style -->
		<Style
			x:Key="SettingsGroupCardStyle"
			TargetType="{x:Type ui:Card}"
			BasedOn="{StaticResource {x:Type ui:Card}}">
			<Setter Property="Padding" Value="12,8" />
			<Setter Property="Margin" Value="0,0,0,8" />
		</Style>

			<!-- 設定グループタイトルStyle -->
		<Style x:Key="SettingsGroupTitleStyle" TargetType="{x:Type TextBlock}">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
			<Setter Property="Margin" Value="0,0,0,4" />
		</Style>

		<!-- 設定グループ説明Style -->
		<Style x:Key="SettingsGroupDescriptionStyle" TargetType="{x:Type TextBlock}">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
		</Style>

		<!-- 設定項目Card Style -->
		<Style
			x:Key="SettingsItemCardStyle"
			TargetType="{x:Type ui:Card}"
			BasedOn="{StaticResource {x:Type ui:Card}}">
			<Setter Property="Padding" Value="12,8" />
			<Setter Property="Margin" Value="0,0,0,2" />
		</Style>

			<!-- Slider + NumberBox 複合数値設定項目Card Style -->
		<Style
			x:Key="SliderNumberSettingItemCardStyle"
			TargetType="{x:Type ui:Card}"
			BasedOn="{StaticResource SettingsItemCardStyle}" />

		<!-- 設定項目タイトルStyle -->
		<Style x:Key="SettingsItemTitleStyle" TargetType="{x:Type TextBlock}">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
		</Style>

		<!-- 設定項目説明Style -->
		<Style x:Key="SettingsItemDescriptionStyle" TargetType="{x:Type TextBlock}">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
			<Setter Property="Margin" Value="0,2,0,0" />
		</Style>
	  </ResourceDictionary>
	</Application.Resources>
</Application>
