<Page x:Class="MangaBinder.HomePage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	  xmlns:local="clr-namespace:MangaBinder.Bindings"
	  xmlns:binding="clr-namespace:MangaBinder.Bindings"
	  xmlns:tags="clr-namespace:MangaBinder.Tags"
	  xmlns:behaviors="clr-namespace:MangaBinder.Behaviors"
	  xmlns:extensions="clr-namespace:MangaBinder.Extensions"
	  xmlns:converters="clr-namespace:MangaBinder.Converters"
	  xmlns:controls="clr-namespace:MangaBinder.Controls"
	  mc:Ignorable="d"
	  d:DesignHeight="800" d:DesignWidth="1200"
	  Title="HomePage"
	  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	  ScrollViewer.CanContentScroll="False">

	<Page.Resources>
		<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
		<converters:HomeEmptyStateKindToVisibilityConverter x:Key="EmptyStateKindToVis" />
		<!-- ViewModel をポップアップ内（切断ツリー）から参照するためのプロキシ -->
		<tags:BindingProxy x:Key="VmProxy" Data="{Binding}" />
		<!-- 素材フォルダ作成日時が null の場合に非表示にするスタイル -->
		<Style x:Key="MaterialFolderCreatedAtTextBlockStyle" TargetType="TextBlock">
			<Setter Property="Visibility" Value="Visible" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding Series.Value.MaterialFolderCreatedAt}" Value="{x:Null}">
					<Setter Property="Visibility" Value="Collapsed" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<!-- タイトル表示専用 TextBox スタイル：TextBlock 寄りの見た目、選択可能 -->
		<Style x:Key="TitleReadOnlyTextBoxStyle" TargetType="TextBox">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="CaretBrush" Value="Transparent" />
			<Setter Property="IsReadOnly" Value="True" />
			<Setter Property="IsTabStop" Value="False" />
		</Style>
		<!-- StartPage と統一した Empty State カードスタイル -->
		<Style x:Key="EmptyStateCardStyle" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="20,14" />
			<Setter Property="Cursor" Value="Hand" />
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
				</Trigger>
			</Style.Triggers>
		</Style>
		<!-- 設定を開くカードスタイル：常に有効、Hover 時に背景・枠線あり -->
		<Style x:Key="SettingsActionCardStyle" TargetType="Border">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="14,10" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
					<Setter Property="BorderThickness" Value="1" />
					<Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
				</Trigger>
			</Style.Triggers>
		</Style>
	</Page.Resources>

	<controls:PageLayout
		EyecatchSymbol="Home24"
		EyecatchTitle="登録作品数"
		EyecatchValueText="{Binding HomeStateInformation.SeriesCount.Value, StringFormat={}{0:N0}&#x20;件}">
		<controls:PageLayout.TopContent>
			<Grid>
				<Grid.ColumnDefinitions>
					<!-- 位置調整用カラム -->
					<ColumnDefinition Width="200" />
					<!-- タイトルジャンプ -->
					<ColumnDefinition Width="Auto" />
					<!-- 残り -->
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<!-- タイトルジャンプCard -->
				<ui:Card Grid.Column="1" Padding="14,10">
					<Grid VerticalAlignment="Center">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<!-- タイトル -->
						<TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3"
								   FontSize="11" Margin="0,0,0,6"
								   Foreground="{DynamicResource TextFillColorSecondaryBrush}">タイトルジャンプ</TextBlock>

						<!-- テキストボックス -->
						<ui:TextBox Grid.Column="0" Grid.Row="1"
									PlaceholderText="タイトルを入力してジャンプ"
									InputMethod.PreferredImeState="On"
									ClearButtonEnabled="True"
									Text="{Binding TitleJumpInput.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									behaviors:TrimOnPasteBehavior.IsEnabled="True"
									behaviors:SelectAllOnFocusBehavior.IsEnabled="True"
									Margin="0,0,8,0"
									Width="350"
									VerticalAlignment="Center">
							<ui:TextBox.InputBindings>
								<KeyBinding Key="Return" Command="{Binding TitleJumpCommand}" />
							</ui:TextBox.InputBindings>
						</ui:TextBox>

						<!-- ジャンプ用SplitButton -->
						<ui:SplitButton Grid.Column="1" Grid.Row="1"
										Appearance="Primary"
										Background="{DynamicResource AccentButtonBackground}"
										Foreground="{DynamicResource AccentButtonForeground}"
										MouseOverBackground="{DynamicResource AccentButtonBackgroundPointerOver}"
										PressedBackground="{DynamicResource AccentButtonBackgroundPressed}"
										Command="{Binding TitleJumpCommand}"
										VerticalAlignment="Center"
										Height="36"
										Margin="0,0,8,0"
										Padding="12,0">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<ui:SymbolIcon Symbol="ArrowBetweenDown24" FontSize="20" Margin="0,0,6,0" />
								<TextBlock Text="ジャンプ" VerticalAlignment="Center" />
							</StackPanel>
						</ui:SplitButton>

						<!-- 戻る用Button -->
						<ui:Button Grid.Column="2" Grid.Row="1"
								   Command="{Binding TitleJumpBackCommand}"
								   VerticalAlignment="Center"
								   Height="36"
								   Padding="12,0">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<ui:SymbolIcon Symbol="ArrowLeft20" FontSize="20" Margin="0,0,6,0" />
								<TextBlock Text="戻る" VerticalAlignment="Center" />
							</StackPanel>
						</ui:Button>
					</Grid>
				</ui:Card>
			</Grid>
		</controls:PageLayout.TopContent>

		<controls:PageLayout.MainContent>
			<Grid>
				<ListView
					Visibility="{Binding HomeStateInformation.EmptyStateKind.Value, Mode=OneWay,
								 Converter={StaticResource EmptyStateKindToVis},
								 ConverterParameter=None}"
					ItemsSource="{Binding Series}"
					SelectionMode="Single"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Stretch"
					VirtualizingPanel.IsVirtualizing="True"
					VirtualizingPanel.VirtualizationMode="Recycling"
					VirtualizingPanel.ScrollUnit="Item"
					ScrollViewer.CanContentScroll="True"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					BorderThickness="0"
					Background="Transparent"
					behaviors:ScrollViewerOffsetBehavior.BoundVerticalOffset="{Binding SavedSeriesListVerticalOffset.Value, Mode=TwoWay}"
					behaviors:ScrollViewerOffsetBehavior.HideUntilRestored="True"
					behaviors:ScrollViewerOffsetBehavior.RequestedVerticalOffset="{Binding JumpRequestedVerticalOffset.Value}"
					behaviors:ScrollViewerOffsetBehavior.ScrollRequest="{Binding JumpScrollRequest.Value}"
					behaviors:CloseToggleOnScrollBehavior.IsEnabled="True"
					behaviors:ViewportPageScrollBehavior.IsEnabled="True"
					behaviors:ListViewVolumeNumberTabNavigationBehavior.IsEnabled="True">

					<ListView.ItemTemplate>
						<DataTemplate>
							<!-- Card で作品一覧の各アイテムを囲む -->
							<ui:Card
								Margin="0,1,12,1"
								Padding="4"
								HorizontalAlignment="Stretch">
								<!-- 最外周4カラム Grid: CheckBox / Thumbnail / MainContent / RightActions -->
								<Grid
									Height="196"
									Margin="0"
									Background="Transparent">
									<Grid.ColumnDefinitions>
										<!-- Col0: 製本対象選択 CheckBox (44) -->
										<ColumnDefinition Width="44" />
										<!-- Col1: サムネイル (140) -->
										<ColumnDefinition Width="140" />
										<!-- Col2: 作品のメインコンテンツ (*) -->
										<ColumnDefinition Width="*" />
										<!-- Col3: 操作UI (Auto) -->
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<!-- Col0: 製本対象選択 CheckBox + ラベル -->
									<StackPanel
										Grid.Column="0"
										VerticalAlignment="Center"
										HorizontalAlignment="Center">
										<TextBlock
											Text="製本"
											FontSize="10"
											Opacity="0.6"
											HorizontalAlignment="Center"
											Margin="0,0,0,4" />
										<CheckBox
											IsChecked="{Binding IsSelected.Value, Mode=OneWay}"
											Command="{Binding DataContext.ToggleBindingQueueCommand, RelativeSource={RelativeSource AncestorType=Page}}"
											CommandParameter="{Binding}"
											HorizontalAlignment="Center" />
									</StackPanel>

								<!-- Col1: サムネイル -->
								<Border
									Grid.Column="1"
									Width="140"
									Height="196"
									VerticalAlignment="Top"
									Background="{DynamicResource ControlFillColorDefaultBrush}"
									CornerRadius="4"
									ClipToBounds="True">
									<Image
										Source="{Binding Series.Value, Converter={extensions:ThumbnailImageConverterExtension}}"
										Width="140"
										Height="196"
										Stretch="UniformToFill"
										RenderOptions.BitmapScalingMode="LowQuality" />
								</Border>

								<!-- Col2: 作品メインコンテンツ (2行 Grid) -->
								<Grid
									Grid.Column="2"
									Margin="12,0,8,0"
									VerticalAlignment="Stretch">
									<Grid.RowDefinitions>
										<!-- Row0: タイトル -->
										<RowDefinition Height="Auto" />
										<!-- Row1: 詳細情報 (2カラム4行 Grid) -->
										<RowDefinition Height="*" />
									</Grid.RowDefinitions>

									<!-- Row0: タイトル -->
									<TextBox
										Grid.Row="0"
										Style="{StaticResource TitleReadOnlyTextBoxStyle}"
										Text="{Binding Series.Value.Title}"
										FontSize="16"
										FontWeight="SemiBold"
										MaxHeight="72"
										HorizontalAlignment="Stretch"
										TextWrapping="Wrap"
										Focusable="True"
										Cursor="IBeam"
										Margin="0,0,0,4" />

									<!-- Row1: 詳細情報 (2カラム2行 Grid) -->
									<Grid Grid.Row="1">
										<Grid.ColumnDefinitions>
											<!-- Col0: メイン情報 (3*) -->
											<ColumnDefinition Width="3*" />
											<!-- Col1: 補助情報 (1*) -->
											<ColumnDefinition Width="1*" />
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<!-- Row0: 巻数情報 / 素材フォルダ作成日時 / メモ -->
											<RowDefinition Height="Auto" />
											<!-- Row1: 残りの詳細領域 -->
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>

										<!-- Row0 / Col0: 巻数情報 + 素材フォルダ作成日時 -->
										<Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,4" VerticalAlignment="Center">
											<Grid.ColumnDefinitions>
												<!-- 巻数情報 -->
												<ColumnDefinition Width="Auto" />
												<!-- 間隔調整 -->
												<ColumnDefinition Width="14" />
												<!-- 素材フォルダ作成日時 -->
												<ColumnDefinition Width="Auto" />
												<!-- 残り -->
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>

											<!-- 巻数情報 -->
											<controls:SeriesVolumeStatus Grid.Column="0"
												DataContext="{Binding VolumeStatus.Value}" />

											<!-- 素材フォルダ作成日時 -->
											<TextBlock Grid.Column="2"
												Style="{StaticResource MaterialFolderCreatedAtTextBlockStyle}"
												Text="{Binding Series.Value.MaterialFolderCreatedAt, StringFormat='[ {0:yyyy/MM/dd HH:mm} ]'}"
												FontSize="12"
												Opacity="0.8"
												VerticalAlignment="Center"
												ToolTip="素材フォルダ作成日時" />
										</Grid>

										<!-- Row0 / Col1: メモ -->
										<controls:SeriesMemo
											Grid.Row="0" Grid.Column="1"
											DataContext="{Binding MemoStatus.Value}"
											HorizontalAlignment="Right"
											VerticalAlignment="Top" />

										<!-- Row1 / Col0: あらすじ専用Grid -->
										<Grid Grid.Row="1" Grid.Column="0">
											<Grid.RowDefinitions>
												<!-- Row0: あらすじ本文 -->
												<RowDefinition Height="*" />
												<!-- Row1: あらすじ出典 -->
												<RowDefinition Height="Auto" />
											</Grid.RowDefinitions>

											<!-- あらすじ -->
											<TextBlock
												Grid.Row="0"
												Text="{Binding Series.Value.Description}"
												FontSize="11"
												Opacity="0.8"
												TextWrapping="Wrap"
												TextTrimming="CharacterEllipsis"
												ClipToBounds="True" />

											<!-- あらすじ出典 -->
											<Grid Grid.Row="1"
												Visibility="{Binding Series.Value.HasDescriptionSource, Converter={StaticResource BooleanToVisibilityConverter}}">
												<Grid.ColumnDefinitions>
													<!-- ラベル -->
													<ColumnDefinition Width="Auto" />
													<!-- ソース名 -->
													<ColumnDefinition Width="Auto" />
													<!-- スラッシュ -->
													<ColumnDefinition Width="Auto" />
													<!-- ソースタイトル -->
													<ColumnDefinition Width="Auto" />
												</Grid.ColumnDefinitions>

												<!-- ラベル "あらすじ出典：" -->
												<TextBlock
													Grid.Column="0"
													Text="あらすじ出典："
													FontSize="11"
													Opacity="0.6"
													VerticalAlignment="Center" />

												<!-- ソース名 -->
												<TextBlock
													Grid.Column="1"
													Text="{Binding Series.Value.DescriptionSourceName}"
													FontSize="11"
													Opacity="0.6"
													VerticalAlignment="Center" />

												<!-- スラッシュ " / " -->
												<TextBlock
													Grid.Column="2"
													Text=" / "
													FontSize="11"
													Opacity="0.6"
													VerticalAlignment="Center" />

												<!-- ソースタイトル -->
												<TextBox
													Grid.Column="3"
													Style="{StaticResource TitleReadOnlyTextBoxStyle}"
													Text="{Binding Series.Value.DescriptionSourceTitle}"
													FontSize="11"
													Opacity="0.6"
													VerticalAlignment="Center"
													Focusable="True"
													Cursor="IBeam" />
											</Grid>
										</Grid>

										<!-- Row1 / Col1: 作者名専用Grid -->
										<Grid Grid.Row="1" Grid.Column="1">
											<Grid.RowDefinitions>
												<!-- Row0: 空き領域 -->
												<RowDefinition Height="*" />
												<!-- Row1: 作者名 -->
												<RowDefinition Height="Auto" />
											</Grid.RowDefinitions>

											<!-- 作者名 -->
											<TextBlock
												Grid.Row="1"
												Text="{Binding Series.Value.Author}"
												FontSize="11"
												Opacity="0.55"
												TextWrapping="NoWrap"
												TextTrimming="CharacterEllipsis"
												VerticalAlignment="Center"
												HorizontalAlignment="Right" />
										</Grid>
									</Grid>
								</Grid>

								<!-- Col3: 右端操作UI (3行 Grid) -->
								<Grid Grid.Column="3">
									<Grid.RowDefinitions>
										<!-- Row0: 3点リーダメニュー -->
										<RowDefinition Height="Auto" />
										<!-- Row1: 編集ボタン（中央） -->
										<RowDefinition Height="*" />
										<!-- Row2: タグボタン -->
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>

									<!-- Row0: 3点リーダメニューボタン -->
									<ui:Button
										Grid.Row="0"
										Appearance="Transparent"
										Width="28"
										Height="28"
										Padding="0"
										VerticalAlignment="Top"
										HorizontalAlignment="Center"
										ToolTip="操作メニュー"
										Background="Transparent"
										BorderBrush="Transparent"
										MouseOverBackground="{DynamicResource ControlFillColorSecondaryBrush}"
										MouseOverBorderBrush="Transparent"
										behaviors:OpenContextMenuOnClickBehavior.IsEnabled="True">
										<ui:Button.ContextMenu>
											<ContextMenu>
												<!-- 素材フォルダを開く -->
												<MenuItem
													Header="素材フォルダを開く"
													IsEnabled="{Binding PlacementTarget.DataContext.Series.Value.HasMaterialSources,
																RelativeSource={RelativeSource AncestorType=ContextMenu}}"
													Command="{Binding Data.OpenMaterialFolderCommand, Source={StaticResource VmProxy}}"
													CommandParameter="{Binding PlacementTarget.DataContext.Series.Value.PrimaryMaterialSource,
																		   RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
											</ContextMenu>
										</ui:Button.ContextMenu>
										<ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16" />
									</ui:Button>

									<!-- Row1: 編集ボタン（中央） -->
									<ui:Button
										Grid.Row="1"
										Appearance="Transparent"
										Width="28"
										Height="28"
										Padding="0"
										VerticalAlignment="Center"
										HorizontalAlignment="Center"
										Background="Transparent"
										BorderBrush="Transparent"
										ToolTip="作品を編集"
										Command="{Binding DataContext.EditSeriesCommand, RelativeSource={RelativeSource AncestorType=Page}}"
										CommandParameter="{Binding Series.Value}">
										<TextBlock Text="▶"
											FontSize="12"
											Opacity="0.6"
											VerticalAlignment="Center"
											HorizontalAlignment="Center"
											Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
									</ui:Button>

									<!-- Row2: タグボタン -->
									<controls:SeriesTagPicker
										Grid.Row="2"
										DataContext="{Binding TagSelector}"
										ButtonContent="{Binding CompactDisplayText.Value}"
										VerticalAlignment="Bottom"
										HorizontalAlignment="Center" />
								</Grid>
							</Grid>
						</ui:Card>
						</DataTemplate>
					</ListView.ItemTemplate>

				</ListView>

				<!-- Empty State 1: 素材フォルダ未登録 -->
				<Grid
					  Visibility="{Binding HomeStateInformation.EmptyStateKind.Value, Mode=OneWay,
								   Converter={StaticResource EmptyStateKindToVis},
								   ConverterParameter=MaterialFolderNotRegistered}">
					<StackPanel VerticalAlignment="Top" Width="320" Margin="140,50,0,0" HorizontalAlignment="Left">
						<TextBlock FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10">作品がまだ登録されていません</TextBlock>
						<TextBlock FontSize="13" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,28">
							<Run>まずは設定画面で素材フォルダを登録してください。</Run>
							<LineBreak />
							<Run>登録後、バックグラウンドで素材フォルダをスキャンし、作品一覧を作成します。</Run>
						</TextBlock>
						<Border Style="{StaticResource SettingsActionCardStyle}" MinWidth="230" Width="230" HorizontalAlignment="Left">
							<Border.InputBindings>
								<MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToSettingsCommand}" />
							</Border.InputBindings>
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<ui:SymbolIcon Symbol="Settings24" FontSize="48"
											   Foreground="{DynamicResource BindingAccentBrush}"
											   Margin="0,0,12,0" VerticalAlignment="Center" />
								<StackPanel>
									<TextBlock FontSize="11" Margin="0,0,0,2"
											   Foreground="{DynamicResource TextFillColorSecondaryBrush}">設定</TextBlock>
									<TextBlock FontSize="16" FontWeight="SemiBold">設定を開く</TextBlock>
								</StackPanel>
							</StackPanel>
						</Border>
					</StackPanel>
				</Grid>

				<!-- Empty State 2: スキャン完了済みだが作品なし -->
				<Grid
					  Visibility="{Binding HomeStateInformation.EmptyStateKind.Value, Mode=OneWay,
								   Converter={StaticResource EmptyStateKindToVis},
								   ConverterParameter=MaterialFolderScanCompletedButNoSeries}">
					<StackPanel VerticalAlignment="Top" Width="280" Margin="140,50,0,0" HorizontalAlignment="Left">
						<TextBlock FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10">作品が見つかりませんでした</TextBlock>
						<TextBlock FontSize="13" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,28">
							<Run>素材フォルダは登録されていますが、作品が登録されていません。</Run>
							<LineBreak />
							<Run>フォルダ名・ファイル名が MangaBinder の命名ルールに合っていない可能性があります。</Run>
						</TextBlock>
						<Border Style="{StaticResource SettingsActionCardStyle}" MinWidth="230" Width="230" HorizontalAlignment="Left">
							<Border.InputBindings>
								<MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToSettingsCommand}" />
							</Border.InputBindings>
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<ui:SymbolIcon Symbol="Settings24" FontSize="48"
											   Foreground="{DynamicResource BindingAccentBrush}"
											   Margin="0,0,12,0" VerticalAlignment="Center" />
								<StackPanel>
									<TextBlock FontSize="11" Margin="0,0,0,2"
											   Foreground="{DynamicResource TextFillColorSecondaryBrush}">設定</TextBlock>
									<TextBlock FontSize="16" FontWeight="SemiBold">設定を開く</TextBlock>
								</StackPanel>
							</StackPanel>
						</Border>
					</StackPanel>
				</Grid>
			</Grid>
		</controls:PageLayout.MainContent>
	</controls:PageLayout>
</Page>
